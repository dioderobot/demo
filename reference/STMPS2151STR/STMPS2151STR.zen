"""
STMPS21x Single Channel Power Switch Reference Design
Author: Nasheed Ur Rehman

Datasheet: https://www.st.com/resource/en/datasheet/stmps2151.pdf
"""

# ----------------------------------------------------------------------------
# Libraries & Dependencies
# ----------------------------------------------------------------------------

load("@stdlib/units.zen", "Capacitance", "Current", "Frequency", "Inductance", "Resistance", "Voltage")

# ----------------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Component Modules
# ----------------------------------------------------------------------------

STMPS2151STR = Module("github.com/dioderobot/demo/components/STMicroelectronics/STMPS2151STR/STMPS2151STR.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")

# ----------------------------------------------------------------------------
# io_interfaces
# ----------------------------------------------------------------------------

VIN = io(Power)
VOUT = io(Power)
GND = io(Ground)

ENABLE = io(Net)
FAULT = io(Net)

# ----------------------------------------------------------------------------
# Componenta
# ----------------------------------------------------------------------------

STMPS2151STR(
    name="STMPS2151STR",
    IN=VIN,
    OUT=VOUT,
    GND=GND,
    EN=ENABLE,
    FAULT=FAULT,
)

Capacitor(
    name="C_IN",
    value="100nF",
    voltage="16V",
    dielectric="X7R",
    package="0402",
    P1=VIN,
    P2=GND,
)

Capacitor(
    name="C_OUT",
    value="100nF",
    voltage="16V",
    dielectric="X7R",
    package="0402",
    P1=VOUT,
    P2=GND,
)


