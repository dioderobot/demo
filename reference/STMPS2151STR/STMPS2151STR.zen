"""
STMPS21x Single Channel Power Switch Reference Design
Author: Nasheed Ur Rehman

Datasheet: https://www.st.com/resource/en/datasheet/stmps2151.pdf
"""

# ----------------------------------------------------------------------------
# Libraries & Dependencies
# ----------------------------------------------------------------------------

load("@stdlib/config.zen", "config_properties")
load("@stdlib/interfaces.zen", "Power")
load("@stdlib/units.zen", "Capacitance", "Current", "Frequency", "Inductance", "Resistance", "Voltage")

# ----------------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Component Modules
# ----------------------------------------------------------------------------

STMPS2151STR = Module("github.com/dioderobot/demo/components/STMicroelectronics/STMPS2151STR/STMPS2151STR.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")

# ----------------------------------------------------------------------------
# io_interfaces
# ----------------------------------------------------------------------------

io_vin = io("vin", Net, default = Net("vin", symbol = Symbol("@kicad-symbols/power.kicad_sym:VDD")))
io_vout = io("vout", Net, default = Net("vout", symbol = Symbol("@kicad-symbols/power.kicad_sym:VDD")))
io_gnd = io("gnd", Net, default = Net("gnd", symbol = Symbol("@kicad-symbols/power.kicad_sym:GND")))

io_enable = io("enable", Net)
io_fault = io("fault", Net)

# ----------------------------------------------------------------------------
# Componenta
# ----------------------------------------------------------------------------

STMPS2151STR(
    name = "STMPS2151STR",
    IN = io_vin,
    OUT = io_vout,
    GND = io_gnd,
    EN = io_enable,
    FAULT = io_fault,
)

Capacitor(
    name = "C_IN",
    value = "100nF",
    voltage = "16V",
    dielectric = "X7R",
    package = "0402",
    P1 = io_vin,
    P2 = io_gnd,
)

Capacitor(
    name = "C_OUT",
    value = "100nF",
    voltage = "16V",
    dielectric = "X7R",
    package = "0402",
    P1 = io_vout,
    P2 = io_gnd,
)

add_property("datasheet", "github.com/dioderobot/demo/components/STMicroelectronics/STMPS2151STR/STMPS2151STR.pdf")

