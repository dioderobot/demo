"""
LIS3DH 3-axis accelerometer Reference Design
Author: Nasheed Ur Rehman

Datasheet: https://www.st.com/resource/en/datasheet/lis3dh.pdf

"""
# ----------------------------------------------------------------------------
# Libraries & Dependencies
# ----------------------------------------------------------------------------

load("@stdlib/interfaces.zen", "Power", "NotConnected", "Ground")
load(
    "@stdlib/units.zen",
    "Capacitance",
    "Current",
    "Frequency",
    "Inductance",
    "Resistance",
    "Voltage",
)

# ----------------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------------

InterfaceMode = enum("I2C", "SPI3W", "SPI4W")
I2C_Address = enum("0x18", "0x19")

config_interface = config("interface", InterfaceMode, default=InterfaceMode("I2C"))
if config_interface == InterfaceMode("I2C"):
    config_i2c_address = config("i2c_address", I2C_Address, default=I2C_Address("0x18"))
    config_add_i2c_pullups = config("add_i2c_pullups", bool, default=False)

config_seperate_vddio = config("seperate_vddio", bool, default=False)

# ----------------------------------------------------------------------------
# Component Modules
# ----------------------------------------------------------------------------

LIS3DH = Module("github.com/dioderobot/demo/components/STMicroelectronics/LIS3DH/LIS3DH.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")

# ----------------------------------------------------------------------------
# io_interfaces
# ----------------------------------------------------------------------------

# Power IOs (always exposed)
io_vdd = io("vdd", Power)

# Optional separate VDDIO
if config_seperate_vddio:
    io_vddio = io("vddio", Power)
else:
    io_vddio = io_vdd

io_gnd = io("gnd", Ground)

# I2C mode: SDA, SCL
# Per datasheet: CS must be tied high for I2C mode
if config_interface == InterfaceMode("I2C"):
    io_sda = io("sda", Net)
    io_scl = io("scl", Net)

    _cs = io_vddio
    _sclk = io_scl
    _sda_sdi_sdo = io_sda
    _sdo_sa0 = io_gnd if config_i2c_address == I2C_Address("0x18") else io_vddio

    # 3-wire SPI: CS, SCLK, SDIO (bidirectional data)
elif config_interface == InterfaceMode("SPI3W"):
    io_cs = io("cs", Net)
    io_sclk = io("sclk", Net)
    io_sdio = io("sdio", Net)

    _cs = io_cs
    _sclk = io_sclk
    _sda_sdi_sdo = io_sdio
    _sdo_sa0 = io_sdio

    # 4-wire SPI: CS, SCLK, MOSI, MISO
elif config_interface == InterfaceMode("SPI4W"):
    io_cs = io("cs", Net)
    io_sclk = io("sclk", Net)
    io_mosi = io("mosi", Net)
    io_miso = io("miso", Net)

    _cs = io_cs
    _sclk = io_sclk
    _sda_sdi_sdo = io_mosi
    _sdo_sa0 = io_miso

# Interrupt pins (optional)
io_int1 = io("int1", Net, optional=True, default=Net("INT1"))
io_int2 = io("int2", Net, optional=True, default=Net("INT2"))

# ----------------------------------------------------------------------------
# Components
# ----------------------------------------------------------------------------

LIS3DH(
    name="LIS3DH",
    VDD=io_vdd,
    VDD_IO=io_vddio,
    GND=io_gnd,
    CS=_cs,
    SPC=_sclk,  # SPI clock pin
    SDI=_sda_sdi_sdo,  # SPI/I2C data input
    SDO=_sdo_sa0,  # SPI data output / I2C address select
    INT1=io_int1,
    INT2=io_int2,
    ADC1=Net("ADC1"),
    ADC2=Net("ADC2"),
    ADC3=Net("ADC3"),
    NC=NotConnected(),
    # Note: RES pin is internally connected to GND in the package
)

Capacitor(
    name="C_VDD",
    value="100nF",
    package="0402",
    P1=io_vdd,
    P2=io_gnd,
)

Capacitor(
    name="C_VDDIO",
    value="100nF",
    package="0402",
    P1=io_vddio,
    P2=io_gnd,
)

if config_interface == InterfaceMode("I2C") and config_add_i2c_pullups:
    Resistor(
        name="R_SDA",
        value="4.7kohms",
        package="0402",
        P1=io_sda,
        P2=io_vddio,
    )

    Resistor(
        name="R_SCL",
        value="4.7kohms",
        package="0402",
        P1=io_scl,
        P2=io_vddio,
    )

# ----------------------------------------------------------------------------
# Datasheet
# ----------------------------------------------------------------------------


