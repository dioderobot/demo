# pcb:sch R_SDA.R x=1373.1400 y=-115.3000 rot=180
# pcb:sch C_VDD.C x=1896.3800 y=-64.5000 rot=0
# pcb:sch C_VDDIO.C x=1997.9800 y=-64.5000 rot=0
# pcb:sch LIS3DH.LIS3DH x=1561.1000 y=-153.4000 rot=0
