"""
LIS3DH 3-axis accelerometer Reference Design
Author: Nasheed Ur Rehman

Datasheet: https://www.st.com/resource/en/datasheet/lis3dh.pdf

"""
# ----------------------------------------------------------------------------
# Libraries & Dependencies
# ----------------------------------------------------------------------------

load(
    "@stdlib/units.zen",
    "Capacitance",
    "Current",
    "Frequency",
    "Inductance",
    "Resistance",
    "Voltage",
)

# ----------------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------------

InterfaceMode = enum("I2C", "SPI3W", "SPI4W")
I2C_Address = enum("0x18", "0x19")

config_interface = config("interface", InterfaceMode, default=InterfaceMode("I2C"))
if config_interface == InterfaceMode("I2C"):
    config_i2c_address = config("i2c_address", I2C_Address, default=I2C_Address("0x18"))
    config_add_i2c_pullups = config("add_i2c_pullups", bool, default=False)

config_seperate_vddio = config("seperate_vddio", bool, default=False)

# ----------------------------------------------------------------------------
# Component Modules
# ----------------------------------------------------------------------------

LIS3DH = Module("github.com/dioderobot/demo/components/STMicroelectronics/LIS3DH/LIS3DH.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")

# ----------------------------------------------------------------------------
# io_interfaces
# ----------------------------------------------------------------------------

# Power IOs (always exposed)
VDD = io("VDD", Power)

# Optional separate VDDIO
if config_seperate_vddio:
    VDD_IO = io("VDDIO", Power)
else:
    VDD_IO = VDD

GND = io("GND", Ground)

# I2C mode: SDA, SCL
# Per datasheet: CS must be tied high for I2C mode
if config_interface == InterfaceMode("I2C"):
    SDA = io("SDA", Net)
    SCL = io("SCL", Net)

    _cs = VDD_IO
    _sclk = SCL
    _sda_sdi_sdo = SDA
    _sdo_sa0 = GND if config_i2c_address == I2C_Address("0x18") else VDD_IO

    # 3-wire SPI: CS, SCLK, SDIO (bidirectional data)
elif config_interface == InterfaceMode("SPI3W"):
    CS = io("CS", Net)
    SCLK = io("SCLK", Net)
    SDIO = io("SDIO", Net)

    _cs = CS
    _sclk = SCLK
    _sda_sdi_sdo = SDIO
    _sdo_sa0 = SDIO

    # 4-wire SPI: CS, SCLK, MOSI, MISO
elif config_interface == InterfaceMode("SPI4W"):
    CS = io("CS", Net)
    SCLK = io("SCLK", Net)
    MOSI = io("MOSI", Net)
    MISO = io("MISO", Net)

    _cs = CS
    _sclk = SCLK
    _sda_sdi_sdo = MOSI
    _sdo_sa0 = MISO

# Interrupt pins (optional)
INT1 = io("INT1", Net, optional=True, default=Net("INT1"))
INT2 = io("INT2", Net, optional=True, default=Net("INT2"))

# ----------------------------------------------------------------------------
# Components
# ----------------------------------------------------------------------------

LIS3DH(
    name="LIS3DH",
    VDD=VDD,
    VDD_IO=VDD_IO,
    GND=GND,
    CS=_cs,
    SPC=_sclk,  # SPI clock pin
    SDI=_sda_sdi_sdo,  # SPI/I2C data input
    SDO=_sdo_sa0,  # SPI data output / I2C address select
    INT1=INT1,
    INT2=INT2,
    ADC1=Net("ADC1"),
    ADC2=Net("ADC2"),
    ADC3=Net("ADC3"),
    NC=NotConnected(),
    # Note: RES pin is internally connected to GND in the package
)

Capacitor(
    name="C_VDD",
    value="100nF",
    package="0402",
    P1=VDD,
    P2=GND,
)

Capacitor(
    name="C_VDDIO",
    value="100nF",
    package="0402",
    P1=VDD_IO,
    P2=GND,
)

if config_interface == InterfaceMode("I2C") and config_add_i2c_pullups:
    Resistor(
        name="R_SDA",
        value="4.7kohms",
        package="0402",
        P1=SDA,
        P2=VDD_IO,
    )

    Resistor(
        name="R_SCL",
        value="4.7kohms",
        package="0402",
        P1=SCL,
        P2=VDD_IO,
    )

# ----------------------------------------------------------------------------
# Datasheet
# ----------------------------------------------------------------------------


