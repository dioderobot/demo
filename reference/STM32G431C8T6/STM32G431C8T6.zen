# ============================================================================
# STM32G431C8T6 Reference Design
# Author: Nasheed Ur Rehman
# Datasheet: <link>
# ============================================================================

# ----------------------------------------------------------------------------
# Libraries & Dependencies
# ----------------------------------------------------------------------------

load("@stdlib/units.zen", "Voltage", "Current", "Capacitance", "Inductance", "Frequency", "Resistance")
load("@stdlib/interfaces.zen", "Spi", "I2c", "Usb2", "Swd")

# ----------------------------------------------------------------------------
# Component Modules
# ----------------------------------------------------------------------------

MCU = Module("github.com/dioderobot/demo/components/STMicroelectronics/STM32G431C8T6/STM32G431C8T6.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")
Crystal = Module("@stdlib/generics/Crystal.zen")
Oscillator = Module(
    "github.com/dioderobot/demo/components/Murata_Electronics/CSTNE8M00GH5C000R0/CSTNE8M00GH5C000R0.zen"
)
Inductor = Module("@stdlib/generics/Inductor.zen")
FerriteBead = Module("@stdlib/generics/FerriteBead.zen")

# ----------------------------------------------------------------------------
# Configuration Parameters
# ----------------------------------------------------------------------------

osc_freq = config("crystal_frequency", Frequency, default="8MHz")
osc_load = config("crystal_load", Capacitance, default="12.5pF")
osc_series_resistance = config("crystal_series_resistance", Resistance, default="100ohms")

# ----------------------------------------------------------------------------
# Global Power Interfaces
# ----------------------------------------------------------------------------

V3V3 = io(Power)
GND = io(Ground)

# ----------------------------------------------------------------------------
# Global IO Nets
# ----------------------------------------------------------------------------

PA0 = io(Net)
PA1 = io(Net)
PA2 = io(Net)
PA3 = io(Net)
PA4 = io(Net)
PA5 = io(Net)
PA6 = io(Net)
PA7 = io(Net)
PA8 = io(Net)
PA9 = io(Net)
PA10 = io(Net)
PA11 = io(Net)
PA12 = io(Net)
PA13 = io(Net)
PA14 = io(Net)
PA15 = io(Net)

PB0 = io(Net)
PB1 = io(Net)
PB2 = io(Net)
PB3 = io(Net)
PB4 = io(Net)
PB5 = io(Net)
PB6 = io(Net)
PB7 = io(Net)
PB8_BOOT0 = io(Net)
PB9 = io(Net)
PB10 = io(Net)
PB11 = io(Net)
PB12 = io(Net)
PB13 = io(Net)
PB14 = io(Net)
PB15 = io(Net)

# Note: STM32G431C8T6 doesn't have PC4, PC6, PC10, PC11 pins (only in CBU6 package)
PC13 = io(Net)
PC14_OSC32_IN = io(Net)
PC15_OSC32_OUT = io(Net)

NRST = io(Net)

# ----------------------------------------------------------------------------
# Local Nets
# ----------------------------------------------------------------------------

VDDA = Net()
VREFP = Net()

XIN = Net()
XOUT = Net()
R_XIN = Net()

# ============================================================================
# Components
# ============================================================================

MCU(
    name="U1",
    PA0=PA0,
    PA1=PA1,
    PA2=PA2,
    PA3=PA3,
    PA4=PA4,
    PA5=PA5,
    PA6=PA6,
    PA7=PA7,
    PA8=PA8,
    PA9=PA9,
    PA10=PA10,
    PA11=PA11,
    PA12=PA12,
    PA13=PA13,
    PA14=PA14,
    PA15=PA15,
    PB0=PB0,
    PB1=PB1,
    PB2=PB2,
    PB3=PB3,
    PB4=PB4,
    PB5=PB5,
    PB6=PB6,
    PB7=PB7,
    PB8MBOOT0=PB8_BOOT0,
    PB9=PB9,
    PB10=PB10,
    PB11=PB11,
    PB12=PB12,
    PB13=PB13,
    PB14=PB14,
    PB15=PB15,
    PC13=PC13,
    PC14_M_OSC32_IN=PC14_OSC32_IN,
    PC15_M_OSC32_OUT=PC15_OSC32_OUT,
    PF0_M_OSC_IN=R_XIN,
    PF1_M_OSC_OUT=XOUT,
    PG10_M_NRST=NRST,
    VBAT=V3V3,
    VDDA=VDDA,
    VDD_1=V3V3,
    VDD_2=V3V3,
    VDD_3=V3V3,
    VREFP=VDDA,
    VSS_1=GND,
    VSS_2=GND,
    VSS_3=GND,
    VSSA=GND,
)

# Decoupling Capacitors

Capacitor(name="C_VDD1", package="0402", value="100nF", voltage="16V", dielectric="X7R", P1=V3V3, P2=GND)


Capacitor(name="C_VDD2", value="100nF", package="0402", voltage="16V", dielectric="X7R", P1=V3V3, P2=GND)

Capacitor(name="C_VDD3", value="4.7uF", package="0603", voltage="10V", dielectric="X5R", P1=V3V3, P2=GND)

Capacitor(name="C_VDD4", value="100nF", package="0402", voltage="16V", dielectric="X7R", P1=V3V3, P2=GND)

# Reset Capacitor

Capacitor(name="C_nRST", value="100nF", package="0402", voltage="16V", dielectric="X7R", P1=NRST, P2=GND)

# Crystal Oscillator Circuit

Oscillator(
    name="Y_HSE",
    GND=GND,
    INPUT=XIN,
    OUTPUT=XOUT,
)
Resistor(name="R_HSE", value="220ohms", package="0402", P1=XIN, P2=R_XIN)

# VDDA Filter Circuit

Capacitor(
    name="C_VDDA",
    value="1uF",
    package="0402",
    voltage="25V",
    dielectric="X5R",
    mpn="CL05A105KP5NNNC",
    manufacturer="Samsung Electro-Mechanics",
    P1=VDDA,
    P2=GND,
)

Capacitor(name="C_VDDA2", value="10nF", package="0402", voltage="16V", dielectric="X7R", P1=VDDA, P2=GND)

FerriteBead(
    name="FB_VDDA",
    value="600ohms",
    frequency="100MHz",
    package="0402",
    mpn="MMZ1005S601CT000",
    manufacturer="TDK Corporation",
    P1=V3V3,
    P2=VDDA,
)
# ============================================================================
# Module Properties
# ============================================================================


