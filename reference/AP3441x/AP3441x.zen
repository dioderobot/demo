# pcb:sch AP3441LSHEM7B.AP3441LSHE-7B x=214.9000 y=62.5000 rot=0

# pcb:sch AP3441SHEM7B.AP3441SHE-7B x=202.2000 y=49.8000 rot=0
# pcb:sch C_FB.C x=-262.6200 y=-13.7000 rot=0
# pcb:sch C_VIN_BULK.C x=-8.6200 y=164.1000 rot=0
# pcb:sch C_VIN_DECOUPLING.C x=92.9800 y=164.1000 rot=0
# pcb:sch C_VOUT_BULK.C x=816.8800 y=126.0000 rot=0
# pcb:sch C_VOUT_DECOUPLING.C x=981.9800 y=126.0000 rot=0
# pcb:sch L_OUT.XAL_Inductor.XAL5030-222MEC x=570.5000 y=63.0207 rot=0
# pcb:sch R_FB_BOTTOM.R x=-87.3600 y=164.1000 rot=0
# pcb:sch R_FB_TOP.R x=-87.3600 y=-13.7000 rot=0
# pcb:sch gnd.1 x=341.9000 y=316.5000 rot=0
# pcb:sch vin.1 x=105.6800 y=-64.5000 rot=0
# pcb:sch vout.1 x=-84.8200 y=-64.5000 rot=0
# pcb:sch vout.2 x=994.6800 y=24.4000 rot=0
