"""
AP22653W6-7 Adjustable Current Limit Switch Reference Design
Author: Nasheed Ur Rehman

Usage:
  Standard current limit settings (automatic RLIM configuration):
    - Set config_current_limit to one of: "150mA", "250mA", "500mA", "750mA",
      "1000mA", "1250mA", "1500mA", "1750mA", "2000mA", "2500mA"
    - RLIM resistor is automatically configured based on datasheet values

  Custom current limit:
    - Set config_current_limit to "Custom"
    - Override config_ilim_resistance with your desired RLIM value
    - Formula from datasheet: I_LIMIT[mA] ≈ 30321 / R[kΩ]^1.055 (typical)
    - Valid range: 10kΩ ≤ RLIM ≤ 210kΩ

Datasheet: https://www.diodes.com/assets/Datasheets/AP22652_53_52A_53A.pdf
"""

# ----------------------------------------------------------------------------
# Libraries & Dependencies
# ----------------------------------------------------------------------------

load("@stdlib/interfaces.zen", "Power", "Ground")
load("@stdlib/units.zen", "Capacitance", "Current", "Frequency", "Inductance", "Resistance", "Voltage")

# ----------------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------------

# Current limit options based on datasheet
CurrentLimit = enum(
    "150mA", "250mA", "500mA", "750mA", "1000mA", "1250mA", "1500mA", "1750mA", "2000mA", "2500mA", "Custom"
)

config_current_limit = config("current_limit", CurrentLimit, default=CurrentLimit("1750mA"))

# Map of current limits to RLIM resistor values
# Based on AP22653 datasheet Table: Current-Limit Threshold vs RLIM
# Using typical values from datasheet with standard resistor values
current_to_resistor_map = {
    CurrentLimit("150mA"): "180kohms",  # ~150mA @ 180kΩ (datasheet: 125mA @ 210kΩ)
    CurrentLimit("250mA"): "100kohms",  # ~250mA @ 100kΩ
    CurrentLimit("500mA"): "49.9kohms",  # 490mA @ 49.9kΩ (datasheet exact)
    CurrentLimit("750mA"): "33kohms",  # ~750mA @ 33kΩ
    CurrentLimit("1000mA"): "27kohms",  # ~1000mA @ 27kΩ
    CurrentLimit("1250mA"): "20kohms",  # 1286mA @ 20kΩ (datasheet exact)
    CurrentLimit("1500mA"): "18kohms",  # ~1500mA @ 18kΩ
    CurrentLimit("1750mA"): "15kohms",  # 1735mA @ 15kΩ (datasheet exact)
    CurrentLimit("2000mA"): "13kohms",  # ~2000mA @ 13kΩ
    CurrentLimit("2500mA"): "10kohms",  # 2665mA @ 10kΩ (datasheet exact)
}

# Allow custom resistor value override
if config_current_limit == CurrentLimit("Custom"):
    config_ilim_resistance = config("ilim_resistance", str, default="15kohms")
else:
    config_ilim_resistance = current_to_resistor_map.get(config_current_limit, "15kohms")

# ----------------------------------------------------------------------------
# Component Modules
# ----------------------------------------------------------------------------

AP22653W6M7 = Module("github.com/dioderobot/demo/components/Diodes_Inc/AP22653W6M7/AP22653W6M7.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")

# ----------------------------------------------------------------------------
# io_interfaces
# ----------------------------------------------------------------------------

VIN = io("VIN", Power)
ENABLE = io("ENABLE", Net)
GND = io("GND", Ground)
VOUT = io("VOUT", Power)

NFAULT = io("NFAULT", Net)

# ----------------------------------------------------------------------------
# local nets
# ----------------------------------------------------------------------------

nc = Net("nc")
ilim = Net("ilim")

# ----------------------------------------------------------------------------
# Components
# ----------------------------------------------------------------------------

AP22653W6M7(
    name="AP22653W6M7",
    IN=VIN,
    OUT=VOUT,
    EN=ENABLE,
    ILIM=ilim,
    n_FAULT=NFAULT,
    GND=GND,
)

Resistor(
    name="R_ILIM",
    value=config_ilim_resistance,
    package="0402",
    P1=ilim,
    P2=GND,
)

Capacitor(
    name="C_IN",
    value="10uF",
    voltage="10V",
    dielectric="X7R",
    package="0805",
    P1=VIN,
    P2=GND,
)

Capacitor(
    name="C_OUT",
    value="10uF",
    voltage="10V",
    dielectric="X7R",
    package="0805",
    P1=VOUT,
    P2=GND,
)

# ----------------------------------------------------------------------------
# Datasheet
# ----------------------------------------------------------------------------]


