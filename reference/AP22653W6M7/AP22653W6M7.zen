# pcb:sch AP22653W6M7.AP22653W6-7 x=570.5000 y=87.9000 rot=0
# pcb:sch C_IN.C x=359.6800 y=138.7000 rot=0
# pcb:sch C_OUT.C x=994.6800 y=138.7000 rot=0
# pcb:sch GND.1 x=697.5000 y=265.7000 rot=0
# pcb:sch VIN.1 x=372.3800 y=62.5000 rot=0
# pcb:sch VOUT.1 x=1007.3800 y=62.5000 rot=0
