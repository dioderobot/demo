+#define AUTORUN_RAMP_MS           2500U
+
+static uint16_t s_delay_ticks = AUTORUN_START_DELAY_TICKS;
+static uint16_t s_refresh_ticks = 0U;
 
 /** @addtogroup MCSDK
   * @{
