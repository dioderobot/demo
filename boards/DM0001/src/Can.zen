# ============================================================================
# CAN Bus Reference Design
# Author: Nasheed Ur Rehman
# ============================================================================

# ----------------------------------------------------------------------------
# Libraries & Dependencies
# ----------------------------------------------------------------------------

load("@stdlib/units.zen", "Voltage", "Current", "Capacitance", "Inductance", "Frequency", "Resistance")
# ----------------------------------------------------------------------------
# Component Modules
# ----------------------------------------------------------------------------

CanSwitch = Module("github.com/dioderobot/demo/reference/FSA5157L6X/FSA5157L6X.zen")
CanTransceiver = Module("github.com/dioderobot/demo/reference/TCAN330DCNT/TCAN330DCNT.zen")
Fuse = Module("github.com/dioderobot/demo/components/Littelfuse/0435_250KRS/0435_250KRS.zen")
JstHeader = Module(
    "github.com/dioderobot/demo/components/JST_JAPAN_SOLDERLESS_TERMINALS/BM05B-SRSS-TB/BM05B-SRSS-TB.zen"
)
Resistor = Module("@stdlib/generics/Resistor.zen")
SchottkyDiode = Module("@stdlib/generics/Rectifier.zen")

# ----------------------------------------------------------------------------
# Global Power Interfaces
# ---------------------------------------------------------------------------

V5V = io(Power)
V3V3 = io(Power)
GND = io(Ground)

# ----------------------------------------------------------------------------
# Global IO Nets
# ----------------------------------------------------------------------------

CAN_RX = io(Net)
CAN_TX = io(Net)
CAN_TERM = io(Net)
CAN_SHDN = io(Net)

# ----------------------------------------------------------------------------
# Local Nets
# ----------------------------------------------------------------------------

CAN_H = Net()
CAN_L = Net()
JST_5V = Net()
S1 = Net()
FUSE = Net()

# ---------------------------------------------------------------------------
# Components
# ----------------------------------------------------------------------------

JstHeader(
    name="JST_CAN",
    MP1=NotConnected(),
    MP2=NotConnected(),
    P1=JST_5V,
    P2=V3V3,
    P3=CAN_H,
    P4=CAN_L,
    P5=GND,
)

CanSwitch(name="FSA5157L6X", VCC=V3V3, GND=GND, A=CAN_H, S=CAN_TERM, B0=NotConnected(), B1=S1, schematic="collapse")

CanTransceiver(
    name="TCAN330DCNT",
    VCC=V3V3,
    GND=GND,
    CAN_RX=CAN_RX,
    CAN_TX=CAN_TX,
    CAN_H=CAN_H,
    CAN_L=CAN_L,
    SHDN=CAN_SHDN,
    schematic="collapse",
)

Fuse(name="Fuse", P1=FUSE, P2=JST_5V)

Resistor(
    name="R_CAN_TERM",
    P1=CAN_L,
    P2=S1,
    value="120ohm 1%",
    package="0402",
)

SchottkyDiode(
    name="D_CAN",
    package="SOD-123",
    technology="Schottky",
    forward_current="350mA",
    reverse_voltage="20V",
    A=FUSE,
    K=V5V,
)

