"""
Seward — CMSIS-DAP v2 USB debug probe, STM32G0B1-based.

USB-C bus-powered, crystal-less USB (HSI48 + CRS). Exposes a 10-pin
ARM Cortex-Debug target header with bidirectional SWD, UART bridge, and
nRESET. Target-side I/O auto-ranges over 1.1–5.0 V via directional
SN74LXC1T45 level shifters powered from the target's VTref rail.

See `spec.md` for full design rationale, back-feed analysis, pin map,
and bring-up checklist.
"""

load("@stdlib/interfaces.zen", "NotConnected", "Swd", "Uart", "UsbTypeC")

UsbC = Module("github.com/diodeinc/registry/connectors/UsbC16P/UsbC16P.zen")
UsbEsd = Module("github.com/diodeinc/registry/components/TPD4E05U06QDQARQ1/TPD4E05U06QDQARQ1.zen")
STM32G0B1 = Module("github.com/diodeinc/registry/components/STMicroelectronics/STM32G0B1KxUxN/STM32G0B1KxUxN.zen")
LDO = Module("github.com/diodeinc/registry/components/Texas_Instruments/TPS74x01P/TPS74x01P.zen")
Button = Module("github.com/diodeinc/registry/components/B3U-1000P/B3U-1000P.zen")
TagConnect = Module("github.com/diodeinc/registry/connectors/TagConnect/TC2030-NL_SWD.zen")
LS = Module("github.com/diodeinc/registry/components/Texas_Instruments/SN74x1T45-DRY/SN74x1T45-DRY.zen")
Ftsh10 = Module(
    "github.com/diodeinc/registry/components/Samtec_Inc/FTSH-105-01-L-DV-K-A-P-TR/FTSH-105-01-L-DV-K-A-P-TR.zen"
)

Resistor = Module("@stdlib/generics/Resistor.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")
Led = Module("@stdlib/generics/Led.zen")
Tvs = Module("@stdlib/generics/Tvs.zen")


VBUS = Power(voltage="4.5V to 5.5V (5V nom.)")
V3V3 = Power(voltage="3.3V")
GND = Ground()

USB_C = UsbTypeC()
SWD = Swd()  # MCU self-SWD via Tag-Connect (PA13/PA14)
SWD_A = Swd()  # MCU ↔ LS A-side (PA4/PA5)
SWD_LS = Swd()  # LS B-side, before series damping
SWD_B = Swd()  # target header side, after damping
UART_A = Uart()  # MCU ↔ LS A-side (PB6/PB7)
UART_B = Uart()  # target header side (post-LS)

SWD_DIR = Net()  # PA6 → LS SWDIO DIR; 1 = A→B (write)
TGT_NRESET = Net()  # PD0 ↔ FTSH pin 10, FT_c open-drain, no LS

# VTREF is sourced by FTSH pin 1; target-driven rail for the LS VCCB.
VTREF = Power(voltage="1.8V to 5.0V")

LED_STATUS = Net()
LED_DAP = Net()
LED_UART_TX = Net()
LED_UART_RX = Net()

NRST = Net()

UCPD2_DBCC1 = Net()
UCPD2_DBCC2 = Net()


def led(name, anode, color, resistance):
    """LED + 0402 series resistor to GND. `anode` is driven high to light."""
    K = Net("LED_" + name + "_K")
    Led(name="D_" + name, color=color, package="0402", A=anode, K=K)
    Resistor(name="R_" + name, value=resistance, package="0402", P1=K, P2=GND)


def level_shifter(name, a, b, dir):
    """One SN74LXC1T45 (VCCA=V3V3, VCCB=VTREF).

    `dir` is the direction net: `V3V3.NET` forces A→B, `GND` forces B→A,
    or pass a firmware-driven net for bidirectional use.
    """
    LS(
        name="U_LS_" + name,
        voltage_a="3.3V",
        voltage_b="1.8V to 5.0V",
        VCCA=V3V3,
        VCCB=VTREF,
        GND=GND,
        A=a,
        B=b,
        DIR=dir,
    )


UsbC(name="J_USB", USB_C=USB_C, VBUS=VBUS, GND=GND)

UsbEsd(name="U_ESD", D1P=USB_C.CC2, D1M=USB_C.CC1, D2M=USB_C.D.P, D2P=USB_C.D.N, GND=GND)

# VBUS TVS — 5 V standoff unidirectional, SMF (SMF5V0A). USB-C vSafe5V
# sits at 4.75–5.25 V nominal, up to 5.5 V worst-case; at 5.5 V the
# TVS is still subthreshold (V_BR min ≈ 6.4 V), leaking tens of µA at
# worst. Clamps surge events from hot-plug / cable strikes at ~9.2 V
# before they reach the LDO.
Tvs(name="D_VBUS_TVS", A=GND, K=VBUS)

LDO(name="U_LDO", output_voltage="3.3V", output_current="500mA", VIN=VBUS, VOUT=V3V3, GND=GND)

STM32G0B1(
    name="U_MCU",
    memory_size="128KB",
    VDD=V3V3,
    GND=GND,
    NRST=NRST,
    # UCPD1 dead-battery Rd: DBCC externally shorted to matching CC
    # (AN5225 §11.3.1) to engage the internal 5.1 kΩ Rd at POR.
    PA8=USB_C.CC1,
    PA9=USB_C.CC1,
    PB15=USB_C.CC2,
    PA10=USB_C.CC2,
    PA11=USB_C.D.N,
    PA12=USB_C.D.P,
    # Self-SWD (PA14 doubles as BOOT0).
    PA13=SWD.SWDIO,
    PA14=SWD.SWCLK,
    # Target-side of level shifters (VCCA = 3V3, A-port = MCU).
    PA4=SWD_A.SWDIO,
    PA5=SWD_A.SWCLK,
    PA6=SWD_DIR,
    PB6=UART_A.TX,
    PB7=UART_A.RX,
    # Target nRESET direct-drive — FT_c (5 V tolerant at VDD=0).
    PD0=TGT_NRESET,
    # PD0 is also UCPD2_CC1 and its dead-battery Rd is gated by
    # PD1/UCPD2_DBCC1 (DS13560 Table 12 note 4). Tie both DBCC inputs
    # low via R_UCPD2_DBCC1/2 so UCPD2 does not engage internal
    # pull-downs on PD0 (TGT_NRESET) or PD2 before firmware strobes
    # UCPD2_STROBE.
    PD1=UCPD2_DBCC1,
    PD3=UCPD2_DBCC2,
    PA0=LED_STATUS,
    PA1=LED_DAP,
    PA2=LED_UART_TX,
    PA3=LED_UART_RX,
)

# SWD_DIR idle pull-down → LS defaults to B→A (read) during MCU reset
# so the target is not back-driven.
Resistor(name="R_SWD_DIR", value="10kohm", package="0402", P1=SWD_DIR, P2=GND)

Resistor(name="R_UCPD2_DBCC1", value="100kohm", package="0402", P1=UCPD2_DBCC1, P2=GND)
Resistor(name="R_UCPD2_DBCC2", value="100kohm", package="0402", P1=UCPD2_DBCC2, P2=GND)

# PA14/BOOT0 must be low at POR to boot from flash; SW_BOOT0 overrides.
Resistor(name="R_BOOT0", value="10kohm", package="0402", P1=SWD.SWCLK, P2=GND)

Button(name="SW_RESET", P1=NRST, P2=GND)
Button(name="SW_BOOT0", P1=SWD.SWCLK, P2=V3V3)

Capacitor(name="C_NRST", value="100nF", package="0402", P1=NRST, P2=GND)

TagConnect(name="J_SWD", VSENSE=V3V3, GND=GND, SWD=SWD, NRST=NRST, SWO=NotConnected())

# Sizing: (3V3 − Vf) / 2 mA → E24. Green/amber Vf ≈ 1.9 V → 680 Ω; blue Vf ≈ 2.6 V → 330 Ω.
led("STATUS", LED_STATUS, "green", "680ohm")
led("DAP", LED_DAP, "yellow", "680ohm")  # amber
led("UART_TX", LED_UART_TX, "blue", "330ohm")
led("UART_RX", LED_UART_RX, "blue", "330ohm")

# Target-side level shifters (SN74LXC1T45, USON-6). Directional push-pull
# translation 1.1–5.5 V both ports. Selector picks LXC over AXC because
# `voltage_b` goes above AXC's 3.6 V rail cap. DIR tied per spec §12.1:
#   SWDIO   — firmware toggles direction around ADI v5 turnaround.
#   SWCLK   — hard A→B (DIR=V3V3).
#   UART_TX — hard A→B (DIR=V3V3).
#   UART_RX — hard B→A (DIR=GND).
level_shifter("SWDIO", SWD_A.SWDIO, SWD_LS.SWDIO, SWD_DIR)
level_shifter("SWCLK", SWD_A.SWCLK, SWD_LS.SWCLK, V3V3.NET)
level_shifter("UART_TX", UART_A.TX, UART_B.TX, V3V3.NET)
level_shifter("UART_RX", UART_A.RX, UART_B.RX, GND)

# Single bulk cap for the LS cluster. Layout: pour VTREF on L3 under
# all four shifters with a via from each VCCB pad straight down; the
# cap sits on the same pour. Loop inductance to each VCCB pin is
# ~1 nH (two short vias + plane spreading) vs. ~4 nH for a trace,
# enough to keep the worst-case edge-transient dip under ~30 mV. No
# per-shifter local decoupling is needed at 10 MHz SWCLK into Hi-Z
# targets. The VCCA (V3V3) pins get the same treatment by via-ing to
# the existing 3V3 pour; the LDO output cap and MCU VDD cap cover
# that rail.
Capacitor(name="C_VTREF", value="1uF", package="0402", P1=VTREF.NET, P2=GND)

# Series damping on SWDIO/SWCLK between LS B-side and the target header.
# 33 Ω + ~20 Ω LXC driver impedance ≈ 53 Ω, close to typical flying-lead
# cable impedance — kills ringing/overshoot on fast edges into Hi-Z
# target inputs. Swap to 0 Ω if bench validation with a short stub shows
# it's unnecessary.
Resistor(name="R_SWDIO_SER", value="33ohm", package="0402", P1=SWD_LS.SWDIO, P2=SWD_B.SWDIO)
Resistor(name="R_SWCLK_SER", value="33ohm", package="0402", P1=SWD_LS.SWCLK, P2=SWD_B.SWCLK)

# Target-side UART_RX idle pull-up to VTREF. UART idles high; with VTref
# present but target TX Hi-Z (held in reset, unconfigured, disconnected),
# the LS B-side input would float. 100 kΩ gives a defined idle that
# passes cleanly through to PB7.
Resistor(name="R_UART_RX_PU", value="100kohm", package="0402", P1=UART_B.RX, P2=VTREF.NET)

# Target header — Samtec FTSH-105 (2×5, 1.27 mm, shrouded/keyed, SMT
# with alignment pegs). ARM Cortex Debug 10-pin pinout with the SWO/TDI
# positions repurposed for UART:
#   1 VTREF       2 SWDIO_B
#   3 GND         4 SWCLK_B
#   5 GND         6 UART_RX_B   (SWO position)
#   7 KEY         8 UART_TX_B   (TDI position)
#   9 GND        10 TGT_NRESET
Ftsh10(
    name="J_TGT",
    P1=VTREF.NET,
    P2=SWD_B.SWDIO,
    P3=GND,
    P4=SWD_B.SWCLK,
    P5=GND,
    P6=UART_B.RX,
    P7=Net("KEY"),
    P8=UART_B.TX,
    P9=GND,
    P10=TGT_NRESET,
)

Board(name="Seward", layout_path="layout", layers=4)
