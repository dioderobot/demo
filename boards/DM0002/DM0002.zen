# ============================================================================
# General purpose debug board based on RP2040
# March 2026 Updates:
# DONE: added diode logo & version number in silkscreen & soldermask
# DONE: resolved back power issue by adding current limiting resistor plus unity gain follower with power-off input protection
# DONE : added level shifter for when the target is 1.8V logic level
# DONE: change SWD header to SMT part for simpler MFG flow
# DONE: level shifter ports to be switched b/c port A can't exceed port B
# ============================================================================

load("@stdlib/interfaces.zen", "Analog", "Gpio", "Swd", "Uart", "Usb2")
# load("@stdlib/board_config.zen", "Board")
# load("@stdlib/units.zen", "Voltage")
load(
    "@stdlib/board_config.zen", "Board", "BoardConfig", "Constraints", "Copper", "DesignRules", "NetClass", "Silkscreen"
)
load("@stdlib/units.zen", "Impedance", "Voltage")


Board(
    name="DM0002",
    layers=4,
    layout_path="layout",
    config=BoardConfig(
        design_rules=DesignRules(
            constraints=Constraints(
                copper=Copper(
                    minimum_annular_width=0.05,
                ),
                silkscreen=Silkscreen(
                    minimum_item_clearance=0.05,
                    minimum_text_height=0.3,
                ),
            ),
            netclasses=[
                # Default netclass
                NetClass(
                    name="Default",
                    clearance=0.1,
                    track_width=0.1,
                    via_diameter=0.5,
                    via_drill=0.3,
                    diff_pair_width=0.127,
                    diff_pair_gap=0.2,
                ),
                # 85Ohm Differential (PCIe)
                NetClass(
                    name="85Ohm Diff",
                    clearance=0.2,
                    track_width=0.1588,
                    diff_pair_width=0.1588,
                    diff_pair_gap=0.127,
                    color="#C200C2FF",
                    differential_pair_impedance=Impedance("85ohm"),
                ),
                # 100Ohm Differential (M-LVDS)
                NetClass(
                    name="100Ohm Diff",
                    clearance=0.2,
                    track_width=0.127,
                    diff_pair_width=0.127,
                    diff_pair_gap=0.1778,
                    color="#C2C200FF",
                    differential_pair_impedance=Impedance("100ohm"),
                ),
            ],
        ),
    ),
)


RP2040 = Module("github.com/dioderobot/demo/modules/RP2040.zen")
USB4105 = Module("github.com/dioderobot/demo/modules/USB4105.zen")
TLV758P = Module("github.com/dioderobot/demo/modules/TLV758P.zen")
Led = Module("github.com/dioderobot/demo/modules/Led.zen")
LMV321 = Module("github.com/dioderobot/demo/modules/LMV321.zen")
TLV9001 = Module("github.com/dioderobot/demo/modules/TLV9001.zen")
TXB0102 = Module("github.com/dioderobot/demo/components/Texas_Instruments/TXB0102DCUR/TXB0102DCUR.zen")
FTSH105 = Module(
    "github.com/dioderobot/demo/components/Samtec_Inc/FTSH-105-01-L-DV-K-A-P-TR/FTSH-105-01-L-DV-K-A-P-TR.zen"
)
LevelShiftFet = Module("github.com/dioderobot/demo/modules/LevelShiftFet/LevelShiftFet.zen")


Version = Module("@stdlib/generics/Version.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")
TestPoint = Module("@stdlib/generics/TestPoint.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")

# Power rails
vbus_5v0 = Power("VBUS_5V0", voltage=Voltage("4.5 to 5.5V"))
vdd_3v3 = Power("VDD_3V3", voltage=Voltage("3.3V"))
gnd = Ground("GND")

# External interfaces
usb = Usb2("USB")
target_swd = Swd("SWD")
target_uart = Uart("TARGET_UART")
target_vddio = Power("TARGET_VDDIO")
target_vddio_buf = Analog("TARGET_V_SENSE_BUFFER")
target_gnd_detect = Analog("TARGET_GND_DETECT")
target_reset = Gpio("TARGET_RESET")

# MCU-side reset signal (3.3V domain, after level shifter)
mcu_reset = Gpio("TARGET_RESET_TO_MCU")

# MCU-side SWD signals (3.3V domain, before level shifter)
mcu_swclk = Gpio("MCU_SWCLK")
mcu_swdio = Gpio("MCU_SWDIO")
swd_ls_oe = Net("SWD_LS_OE")

# MCU-side UART signals (3.3V domain, before level shifter)
mcu_uart_rx = Analog("MCU_UART_RX")
mcu_uart_tx = Analog("MCU_UART_TX")
uart_ls_oe = Net("UART_LS_OE")

# GPIO assignments for RP2040
vbus_det = Gpio("VBUS_DET")
gpio_15_led_orange = Gpio("LED_O1")
gpio_14_led_orange = Gpio("LED_O2")
gpio_12_led_orange = Gpio("LED_O3")
gpio_16_led_green = Gpio("LED_G")
gpio_17_led_blue = Gpio("LED_B")

# USB-C connector with ESD protection
usb_connector = USB4105(
    name="USB_C",
    mode="device",
    VBUS=vbus_5v0,
    USB=usb,
    GND=gnd,
)

# 3.3V LDO regulator
ldo = TLV758P(
    name="LDO_3V3",
    input_voltage="5V",
    output_voltage="3.3V",
    VIN=vbus_5v0,
    VOUT=vdd_3v3,
    GND=gnd,
)

# MCU connections
mcu = RP2040(
    name="MCU",
    VDD_3V3=vdd_3v3,
    GND=gnd,
    USB=usb,
    # GPIO assignments
    GPIO12=gpio_12_led_orange,
    GPIO5=vbus_det,
    GPIO13=gpio_14_led_orange,
    GPIO14=gpio_15_led_orange,
    GPIO16=gpio_16_led_green,
    GPIO17=gpio_17_led_blue,
    GPIO18=mcu_reset,
    GPIO19=mcu_swclk,
    GPIO20=mcu_swdio,
    GPIO26_ADC0=target_vddio_buf,
    GPIO27_ADC1=target_gnd_detect,
    GPIO28_ADC2=mcu_uart_rx,
    GPIO29_ADC3=mcu_uart_tx,
)

idc_header = FTSH105(
    name="SWD_HEADER",
    P1=target_vddio,
    P2=target_swd.SWDIO,
    P3=gnd,
    P4=target_swd.SWCLK,
    P5=gnd,
    P6=target_uart.RX,
    P7=NotConnected(),
    P8=target_uart.TX,
    P9=target_gnd_detect,
    P10=target_reset,
)

# Test points for power rails
TestPoint(name="TP_VBUS", variant="Pad_D1.5mm", P1=vbus_5v0)
TestPoint(name="TP_3V3", variant="Pad_D1.5mm", P1=vdd_3v3)
TestPoint(name="TP_GND", variant="Pad_D1.5mm", P1=gnd)

# VBUS detection voltage divider (5V -> 2.94V for GPIO 5)
# Using 33k + 47k resistors for 5V * 47k/(33k+47k) = 2.94V > VIH(2.31V)
Resistor(name="R_VBUS_DIV_H", package="0402", value="33kOhm", P1=vbus_5v0, P2=vbus_det)
Resistor(name="R_VBUS_DIV_L", package="0402", value="47kOhm", P1=vbus_det, P2=gnd)

# GPIO-controlled Status LEDs (GPIO sources current when high, push-pull topology)
Led(name="LED_B", color="blue", supply_voltage=Voltage("3.3V"), P1=gpio_17_led_blue, P2=gnd)
Led(name="LED_G", color="green", supply_voltage=Voltage("3.3V"), P1=gpio_16_led_green, P2=gnd)
Led(name="LED_O1", color="orange", supply_voltage=Voltage("3.3V"), P1=gpio_15_led_orange, P2=gnd)
Led(name="LED_O2", color="orange", supply_voltage=Voltage("3.3V"), P1=gpio_14_led_orange, P2=gnd)
Led(name="LED_O3", color="orange", supply_voltage=Voltage("3.3V"), P1=gpio_12_led_orange, P2=gnd)

# Power indicator LED
Led(name="LED_PWR", color="red", supply_voltage=Voltage("3.3V"), P1=vdd_3v3, P2=gnd)

# Unity gain buffer for target voltage sense
# TLV9001 has power-off input protection — no back-power through ESD clamps.
# 10kΩ series input resistor provides additional current limiting. 3v @ 10k is far under 10mA limit of TLV9001
target_vddio_r = Net("TARGET_V_SENSE_R")
Resistor(name="R_VBUF_IN", package="0402", value="10kOhm", P1=target_vddio, P2=target_vddio_r)

TLV9001(
    name="U_VBUF",
    IN_POS=target_vddio_r,
    IN_NEG=target_vddio_buf,
    OUT=target_vddio_buf,
    VCC=vdd_3v3,
    GND=gnd,
)

# 0Ω bypass jumper: shorts J1 pin 1 directly to MCU pin 38 (DNP)
Resistor(name="R_BYPASS", package="0402", value="0Ohm", P1=target_vddio, P2=target_vddio_buf, dnp=True)

# SWD level shifter: target voltage domain (A) ↔ MCU 3.3V domain (B)
# VCCA must not exceed VCCB. Target may be 1.8V, so target goes on A (lower).
TXB0102(
    name="U_SWD_LS",
    VCCA=target_vddio,
    VCCB=vdd_3v3,
    GND=gnd,
    OE=swd_ls_oe,
    A1=Gpio(target_swd.SWDIO),
    A2=Gpio(target_swd.SWCLK),
    B1=mcu_swdio,
    B2=mcu_swclk,
)


Capacitor(name="C_LS_VCCA", package="0402", value="100nF", P1=target_vddio, P2=gnd)
Capacitor(name="C_LS_VCCB", package="0402", value="100nF", P1=vdd_3v3, P2=gnd)
Resistor(name="R_LS_OE", package="0402", value="10kOhm", P1=target_vddio, P2=swd_ls_oe)

# UART level shifter: target voltage domain (A) ↔ MCU 3.3V domain (B)
TXB0102(
    name="U_UART_LS",
    VCCA=target_vddio,
    VCCB=vdd_3v3,
    GND=gnd,
    OE=uart_ls_oe,
    A1=Analog(target_uart.RX),
    A2=Analog(target_uart.TX),
    B1=mcu_uart_rx,
    B2=mcu_uart_tx,
)
Capacitor(name="C_ULS_VCCA", package="0402", value="100nF", P1=target_vddio, P2=gnd)
Capacitor(name="C_ULS_VCCB", package="0402", value="100nF", P1=vdd_3v3, P2=gnd)
Resistor(name="R_ULS_OE", package="0402", value="10kOhm", P1=target_vddio, P2=uart_ls_oe)

# Reset level shifter: BSS138 open-drain bidirectional (1.8V target ↔ 3.3V MCU)
# GPIO18 must be configured as open-drain to allow bidirectional reset control.
# Low-side pull-up is DNP — place if there is no pullup on the target.
LevelShiftFet(
    name="U_RST_LS",
    SIGNAL_LOWER=target_reset,
    SIGNAL_UPPER=mcu_reset,
    POWER_LOWER=target_vddio,
    POWER_UPPER=vdd_3v3,
    dnp_pullup_source=True,
)

# Diode Logo
Component(
    name="LOGO",
    description="Diode Logo",
    prefix="TP",
    symbol=Symbol("github.com/dioderobot/demo/modules/graphics/diode/diode.kicad_sym"),
    footprint=File("github.com/dioderobot/demo/components/logo/eda/logo.kicad_mod"),
    pin_defs={},
    pins={},
    skip_bom=True,
    skip_pos=True,
)

# Version number silkscreen
Version(name="Version")

