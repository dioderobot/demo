"""
DSI_CSI - CM5 Carrier
Author: Nasheed Ur Rehman
"""

# ----------------------------------------------------------------------------
# Libraries & Dependencies
# ----------------------------------------------------------------------------

load("@stdlib/interfaces.zen", "I2c", "Mipi")
load("@stdlib/units.zen", "Capacitance", "Current", "Frequency", "Inductance", "Resistance", "Voltage")

# ----------------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Component Modules
# ----------------------------------------------------------------------------

DSI_CSI_Connector = Module("github.com/dioderobot/demo/components/Hirose/FH12M22SM0_5SH/FH12M22SM0_5SH.zen")

# ----------------------------------------------------------------------------
# io interfaces
# ----------------------------------------------------------------------------

V3V3PI = io("3V3PI", Power)
GND = io("GND", Ground)

DPHY0_C = io("DPHY0_C", Mipi)
I2C = io("I2C", I2c)
CAM_GPIO0 = io("CAM_GPIO0", Net)
CAM_GPIO1 = io("CAM_GPIO1", Net)

# ----------------------------------------------------------------------------
# Components
# ----------------------------------------------------------------------------

DSI_CSI_Connector(
    name="DSI_CSI_Connector",
    P1=V3V3PI,
    P2=I2C.SDA,
    P3=I2C.SCL,
    P4=GND,
    P5=CAM_GPIO1,
    P6=CAM_GPIO0,
    P7=GND,
    P8=DPHY0_C.DATA3.P,
    P9=DPHY0_C.DATA3.N,
    P10=GND,
    P11=DPHY0_C.DATA2.P,
    P12=DPHY0_C.DATA2.N,
    P13=GND,
    P14=DPHY0_C.CLK.P,
    P15=DPHY0_C.CLK.N,
    P16=GND,
    P17=DPHY0_C.DATA1.P,
    P18=DPHY0_C.DATA1.N,
    P19=GND,
    P20=DPHY0_C.DATA0.P,
    P21=DPHY0_C.DATA0.N,
    P22=GND,
    MP1=GND,
    MP2=GND,
)

