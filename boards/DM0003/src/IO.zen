"""
IO - CM5 Carrier
Author: Nasheed Ur Rehman
"""

# ----------------------------------------------------------------------------
# Libraries & Dependencies
# ----------------------------------------------------------------------------

load("@stdlib/interfaces.zen", "I2c", "Power", "Spi", "Power", "Ground", "NotConnected")
load("@stdlib/units.zen", "Capacitance", "Current", "Resistance", "Voltage")
load("@stdlib/utils.zen", "e96")

# ----------------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Component Modules
# ----------------------------------------------------------------------------

SPI_Connector = Module(
    "github.com/dioderobot/demo/components/JST_JAPAN_SOLDERLESS_TERMINALS/BM10BMSURSMTF_LF_SN/BM10BMSURSMTF_LF_SN.zen"
)
FAN_Connector = Module(
    "github.com/dioderobot/demo/components/JST_JAPAN_SOLDERLESS_TERMINALS/BM04BMSRSSMTB_LF_SN/BM04BMSRSSMTB_LF_SN.zen"
)
I2C_Connector = Module(
    "github.com/dioderobot/demo/components/JST_JAPAN_SOLDERLESS_TERMINALS/BM04BMSRSSMTB_LF_SN/BM04BMSRSSMTB_LF_SN.zen"
)
Led = Module("@stdlib/generics/Led.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")
LIS3DH = Module("github.com/dioderobot/demo/reference/LIS3DH/LIS3DH.zen")
Reset_Button = Module("github.com/dioderobot/demo/components/OMRON_Electronics/B3UM1000P/B3UM1000P.zen")
ESD_Clamp = Module("github.com/dioderobot/demo/components/Semtech_Corporation/RCLAMP0502BATCT/RCLAMP0502BATCT.zen")
SN74LVC1G14DRLRG4 = Module(
    "github.com/dioderobot/demo/components/Texas_Instruments/SN74LVC1G14DRLRG4/SN74LVC1G14DRLRG4.zen"
)
Power_Button = Module("github.com/dioderobot/demo/components/OMRON_Electronics/B3UM1000P/B3UM1000P.zen")

# ----------------------------------------------------------------------------
# io_interfaces
# ----------------------------------------------------------------------------
V5 = io("5V", Power, default=Power("5V", voltage=Voltage("5V")))
V3V3PI = io("3V3PI", Power, default=Power("3V3PI", voltage=Voltage("3.3V")))
GND = io("GND", Ground)

SPI = io("SPI", Spi)
I2C = io("I2C", I2c)

BL = io("BL", Net)
RST = io("RST", Net)
DC = io("DC", Net)

FAN_PWM = io("FAN_PWM", Net)
FAN_TACHO = io("FAN_TACHO", Net)

N_PWR_LED = io("N_PWR_LED", Net)
N_LED_ACTIVITY = io("N_LED_ACTIVITY", Net)
N_RESET = io("N_RESET", Net)
PWR_BUT = io("PWR_BUT", Net)

R_LED_ACTIVITY = Net("R_LED_ACTIVITY")
R_LED_PWR = Net("R_LED_PWR")
LED_PWR = Net("LED_PWR")

# ----------------------------------------------------------------------------
# Components
# ----------------------------------------------------------------------------

SPI_Connector(
    name="SPI_Connector",
    P1=SPI.MISO,
    P2=SPI.MOSI,
    P3=SPI.CLK,
    P4=BL,
    P5=GND,
    P6=SPI.CS,
    P7=RST,
    P8=DC,
    P9=GND,
    P10=V3V3PI,
    MP1=GND,
    MP2=GND,
)

FAN_Connector(
    name="Fan_Connector",
    P1=V5,
    P2=FAN_PWM,
    P3=GND,
    P4=FAN_TACHO,
)

I2C_Connector(
    name="I2C_Connector",
    P1=GND,
    P2=V3V3PI,
    P3=I2C.SDA,
    P4=I2C.SCL,
)

Resistor(
    name="R_SDA",
    package="0402",
    value="2.2kohms",
    P1=I2C.SDA,
    P2=V3V3PI,
)

Resistor(
    name="R_SCL",
    package="0402",
    value="2.2kohms",
    P1=I2C.SCL,
    P2=V3V3PI,
)

Capacitor(
    name="C_VDD",
    package="0805",
    value="4.7uF",
    voltage="25V",
    dielectric="X7R",
    P1=V3V3PI,
    P2=GND,
)

ESD_Clamp(
    name="ESD_Clamp",
    A=GND,
    K1=I2C.SCL,
    K2=I2C.SDA,
)

LIS3DH(
    name="LIS3DH",
    interface="I2C",
    VDD=V3V3PI,
    GND=GND,
    SDA=I2C.SDA,
    SCL=I2C.SCL,
    schematic="collapse",
)

LED_V_F = "2V"
LED_I_F = "5mA"


def led_current_limit_resistance(supply_voltage, forward_voltage, current_limit):
    return e96((Voltage(supply_voltage) - Voltage(forward_voltage)) / Current(current_limit))


Led(
    name="LED_ACTIVITY",
    package="0402",
    color="green",
    forward_voltage=LED_V_F,
    forward_current=LED_I_F,
    A=V5,
    K=R_LED_ACTIVITY,
)

Resistor(
    name="R_ACTIVITY",
    package="0402",
    value=led_current_limit_resistance(V5.voltage.max, LED_V_F, LED_I_F),
    P1=R_LED_ACTIVITY,
    P2=N_LED_ACTIVITY,
)

Led(
    name="LED_PWR",
    package="0402",
    color="red",
    forward_voltage=LED_V_F,
    forward_current=LED_I_F,
    A=V5,
    K=LED_PWR,
)

Resistor(
    name="R_PWR",
    package="0402",
    value=led_current_limit_resistance(V5.voltage.max, LED_V_F, LED_I_F),
    P1=R_LED_PWR,
    P2=LED_PWR,
)

SN74LVC1G14DRLRG4(
    name="SN74LVC1G14DRLRG4",
    A=N_PWR_LED,
    GND=GND,
    VCC=V5,
    Y=R_LED_PWR,
    N_C=NotConnected(),
)

# Resistor(
#     name = "R_RESET",
#     package = "0402",
#     value = "0ohms",
#     P1 = V3V3PI,
#     P2 = N_RESET,
#     do_not_populate = True,
#     exclude_from_bom = True,
# )

