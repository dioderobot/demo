"""
PCIe-M2 - CM5 Carrier
Author: Nasheed Ur Rehman
"""

# ----------------------------------------------------------------------------
# Libraries & Dependencies
# ----------------------------------------------------------------------------

load("@stdlib/interfaces.zen", "PcieGen3x1Lane", "Power", "Ground", "NotConnected")
load("@stdlib/units.zen", "Capacitance", "Current", "Frequency", "Resistance", "Voltage")
load("@stdlib/utils.zen", "e96")

# ----------------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Component Modules
# ----------------------------------------------------------------------------

PCIe_Connector = Module("github.com/dioderobot/demo/components/TE_Connectivity/1M2199119M3/1M2199119M3.zen")
Crystal = Module("github.com/dioderobot/demo/components/ASEK/ASEKM32_768KHZMLMRMT/ASEKM32_768KHZMLMRMT.zen")
Buck = Module("github.com/dioderobot/demo/reference/AP3441x/AP3441x.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")
Standoff = Module("@stdlib/generics/Standoff.zen")
Led = Module("@stdlib/generics/Led.zen")

# ----------------------------------------------------------------------------
# io_interfaces
# ----------------------------------------------------------------------------

V5 = io("5V", Power, default=Power("5V", voltage=Voltage("5V")))
GND = io("GND", Ground)
PCIE_C = io("PCIE_C", PcieGen3x1Lane)
PCIE_PWR_EN = io("PCIE_PWR_EN", Net)

# ----------------------------------------------------------------------------
# local nets
# ----------------------------------------------------------------------------

M2_3V3 = Power("M2_3V3", voltage=Voltage("3.3V"))
DAS_DSS_LED1 = Net("DAS_DSS_LED1")
R_ACTIVITY = Net("R_ACTIVITY")
SUSCLK = Net("SUSCLK")

# ----------------------------------------------------------------------------
# Components
# ----------------------------------------------------------------------------

PCIe_Connector(
    name="PCIe_Connector",
    PERST=PCIE_C.RESET_N,
    CLKREQ=PCIE_C.CLK_REQ_N,
    PEWAKE=PCIE_C.WAKE_N,
    DEVSLP=NotConnected(),
    PETP0_SATA_APLUS=PCIE_C.TX.N,
    PETN0_SATA_AMINUS=PCIE_C.TX.P,
    PERP0_SATA_BMINUS=PCIE_C.RX.N,
    PERN0_SATA_BPLUS=PCIE_C.RX.P,
    PETP1=NotConnected(),
    PETN1=NotConnected(),
    PERP1=NotConnected(),
    PERN1=NotConnected(),
    PETP2=NotConnected(),
    PETN2=NotConnected(),
    PERP2=NotConnected(),
    PERN2=NotConnected(),
    PETP3=NotConnected(),
    PETN3=NotConnected(),
    PERP3=NotConnected(),
    PERN3=NotConnected(),
    # Reference Clock
    REFCLKP=PCIE_C.REFCLK.P,
    REFCLKN=PCIE_C.REFCLK.N,
    # Power
    VDD=M2_3V3,
    GND=GND,
    # Other signals
    DAS_DSS_LED1=DAS_DSS_LED1,
    PEDET=NotConnected(),
    SUSCLK=SUSCLK,
    # Not connected
    NC=NotConnected(),
)

Standoff(
    name="M_2_Standoff",
    thread="M2.5",
    height="1.5mm",
    P1=GND,
)

LED_V_F = "2V"
LED_I_F = "5mA"


def led_current_limit_resistance(supply_voltage, forward_voltage, current_limit):
    return e96((Voltage(supply_voltage) - Voltage(forward_voltage)) / Current(current_limit))


Led(
    name="LED_Activity",
    package="0402",
    color="green",
    forward_voltage=LED_V_F,
    forward_current=LED_I_F,
    A=M2_3V3,
    K=R_ACTIVITY,
)

Resistor(
    name="R_Activity",
    package="0402",
    value=led_current_limit_resistance(M2_3V3.voltage.max, LED_V_F, LED_I_F),
    P1=DAS_DSS_LED1,
    P2=R_ACTIVITY,
)

Crystal(
    name="Crystal",
    VDD=M2_3V3,
    TRI_STATE=M2_3V3,
    GND=GND,
    OUTPUT=SUSCLK,
)

Buck(
    name="Buck",
    VIN=V5,
    VOUT=M2_3V3,
    GND=GND,
    PG=NotConnected(),
    ENABLE=PCIE_PWR_EN,
    schematic="collapse",
)

Resistor(
    name="R_EN",
    value="100kohms",
    package="0402",
    P1=PCIE_PWR_EN,
    P2=GND,
)

Capacitor(
    name="C_VIN",
    value="10uF",
    package="0805",
    voltage="16V",
    dielectric="X7R",
    P1=V5,
    P2=GND,
)

Capacitor(
    name="C_VOUT1",
    value="10uF",
    package="0805",
    voltage="16V",
    dielectric="X7R",
    P1=M2_3V3,
    P2=GND,
)

Capacitor(
    name="C_VOUT2",
    value="10uF",
    package="0805",
    voltage="16V",
    dielectric="X7R",
    P1=M2_3V3,
    P2=GND,
)

Capacitor(
    name="C_VOUT3",
    value="10uF",
    package="0805",
    voltage="16V",
    dielectric="X7R",
    P1=M2_3V3,
    P2=GND,
)

Capacitor(
    name="C_CRYSTAL",
    value="100nF",
    package="0402",
    voltage="16V",
    dielectric="X7R",
    P1=M2_3V3,
    P2=GND,
)

