"""
USB PD - CM5 Carrier
Author: Nasheed Ur Rehman
"""

# ----------------------------------------------------------------------------
# Libraries & Dependencies
# ----------------------------------------------------------------------------

load("@stdlib/interfaces.zen", "Ground", "Power", "Usb2", "Usb3", "UsbTypeC")
load("@stdlib/properties.zen", "Layout")
load("@stdlib/units.zen", "Capacitance", "Current", "Frequency", "Inductance", "Resistance", "Voltage")

# ----------------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Component Modules
# ----------------------------------------------------------------------------

USB_TypeC_Connector = Module("github.com/dioderobot/demo/components/SHOUHAN/TYPE-C24PQT/TYPE-C24PQT.zen")
ESD = Module("github.com/dioderobot/demo/components/Texas_Instruments/TPD4EUSB30DQAR/TPD4EUSB30DQAR.zen")
Current_Limit_Switch = Module("github.com/dioderobot/demo/reference/AP22653W6M7/AP22653W6M7.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")
RCLAMP0502BATCT = Module(
    "github.com/dioderobot/demo/components/Semtech_Corporation/RCLAMP0502BATCT/RCLAMP0502BATCT.zen"
)
TUSB321RWBR = Module("github.com/dioderobot/demo/components/Texas_Instruments/TUSB321RWBR/TUSB321RWBR.zen")
SSMUX = Module("github.com/dioderobot/demo/components/Texas_Instruments/HD3SS3212IRKSR/HD3SS3212IRKSR.zen")

# ----------------------------------------------------------------------------
# io_interfaces
# ----------------------------------------------------------------------------

V5 = io("V5V", Power)
V3V3 = io("V3V3", Power)
GND = io("GND", Ground)

USB3P = io("USB_3PI", Usb3)
VBUS_EN = io("VBUS_EN", Net)

USB_Connector = UsbTypeC("USB_C")
VBUS = Power("VBUS")
PORT = Net("PORT")
VBUS_DET = Net("VBUS_DET")
DIR = Net("DIR")

USB_TypeC_Connector(
    name="USB_PD",
    VBUS=VBUS,
    CC1=USB_Connector.CC1,
    CC2=USB_Connector.CC2,
    DM=USB3P.D.N,
    DP=USB3P.D.P,
    GND=GND,
    EP=GND,
    SUB1=Net("NC"),
    SUB2=Net("NC"),
    RX1M=USB_Connector.SSRX0.N,
    RX2M=USB_Connector.SSRX1.N,
    RX1P=USB_Connector.SSRX0.P,
    RX2P=USB_Connector.SSRX1.P,
    TX1P=USB_Connector.SSTX0.P,
    TX1M=USB_Connector.SSTX0.N,
    TX2M=USB_Connector.SSTX1.N,
    TX2P=USB_Connector.SSTX1.P,
)
ESD(
    name="ESD_1",
    D1M=USB_Connector.CC2,
    D1P=USB_Connector.CC1,
    D2P=USB3P.D.N,
    D2M=USB3P.D.P,
    GND=GND,
)

ESD(
    name="ESD_2",
    D1M=USB_Connector.SSRX0.P,
    D1P=USB_Connector.SSRX0.N,
    D2M=USB_Connector.SSTX0.P,
    D2P=USB_Connector.SSTX0.N,
    GND=GND,
)

ESD(
    name="ESD_3",
    D1M=USB_Connector.SSRX1.N,
    D1P=USB_Connector.SSRX1.P,
    D2M=USB_Connector.SSTX1.N,
    D2P=USB_Connector.SSTX1.P,
    GND=GND,
)

TUSB321RWBR(
    name="TUSB321RWBR",
    VDD=VBUS,
    GND=GND,
    CC1=USB_Connector.CC1,
    CC2=USB_Connector.CC2,
    OUT1=Net("NC"),
    OUT2=Net("NC"),
    PORT=PORT,
    ID=Net("NC"),
    DIR=DIR,
    CURRENT_MODE=GND,
    VBUS_DET=VBUS_DET,
    n_VCONN_FAULT=Net("NC"),
)

Capacitor(
    name="C_VBUS_DET",
    value="100nF",
    package="0402",
    voltage="16V",
    dielectric="X7R",
    P1=VBUS,
    P2=GND,
)

Resistor(
    name="R_PORT",
    value="4.7kohms",
    package="0402",
    P1=VBUS,
    P2=PORT,
)

Resistor(
    name="R_VBUS_DET",
    value="910kohms",
    package="0402",
    P1=VBUS,
    P2=VBUS_DET,
)

Capacitor(
    name="C_SSMUX",
    value="100nF",
    package="0402",
    voltage="16V",
    dielectric="X7R",
    P1=V3V3,
    P2=GND,
)

SSMUX(
    name="SSMUX",
    VCC=V3V3,
    GND_1=GND,
    GND_2=GND,
    GND_3=GND,
    A0N=USB3P.SSRX.N,
    A0P=USB3P.SSRX.P,
    A1N=USB3P.SSTX.N,
    A1P=USB3P.SSTX.P,
    B1N=USB_Connector.SSTX1.N,
    B1P=USB_Connector.SSTX1.P,
    B0N=USB_Connector.SSRX1.N,
    B0P=USB_Connector.SSRX1.P,
    C1N=USB_Connector.SSTX0.P,
    C1P=USB_Connector.SSTX0.N,
    C0N=USB_Connector.SSRX0.P,
    C0P=USB_Connector.SSRX0.N,
    EPAD=GND,
    OEN=GND,
    RSVD1=Net("NC"),
    RSVD2=Net("NC"),
    SEL=DIR,
)

Current_Limit_Switch(
    name="Current_Limit_Switch",
    VIN=V5,
    VOUT=VBUS,
    GND=GND,
    ENABLE=VBUS_EN,
    NFAULT=Net("NFAULT"),
    current_limit="1750mA",
    schematic="collapse",
)

Component(
    name="C_BULK",
    symbol=Symbol(library="@kicad-symbols/Device.kicad_sym", name="C_Polarized"),
    footprint=File("@kicad-footprints/Capacitor_Tantalum_SMD.pretty/CP_EIA-3528-21_Kemet-B.kicad_mod"),
    pins={
        "1": VBUS,
        "2": GND,
    },
    mpn="TAJB107K006RNJ",
    properties={
        "manufacturer": "KYOCERA AVX",
        "value": "100uF 6.3V",
        "package": "CASE-B-3528-21",
        "datasheet": "https://datasheets.kyocera-avx.com/TAJ.pdf",
        "LCSC Part": "C16133",
    },
)

