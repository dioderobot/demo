"""
USB - CM5 Carrier
Author: Nasheed Ur Rehman
"""

# ----------------------------------------------------------------------------
# Libraries & Dependencies
# ----------------------------------------------------------------------------

load("@stdlib/interfaces.zen", "Usb2")
load("@stdlib/properties.zen", "Layout")
load("@stdlib/units.zen", "Capacitance", "Current", "Frequency", "Inductance", "Resistance", "Voltage")

# ----------------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Component Modules
# ----------------------------------------------------------------------------

Resistor = Module("@stdlib/generics/Resistor.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")
VoltageClamp = Module("github.com/dioderobot/demo/components/Semtech_Corporation/RCLAMP0502BATCT/RCLAMP0502BATCT.zen")

# ----------------------------------------------------------------------------
# io_interfaces
# ----------------------------------------------------------------------------

V5 = io("5V", Power)
GND = io(Ground)
USB2C = io("USB_PI", Usb2)

CC1 = io(Net)
CC2 = io(Net)

# ----------------------------------------------------------------------------
# local nets
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Components
# ----------------------------------------------------------------------------

Component(
    name="USB_Connector",
    symbol=Symbol(library="@kicad-symbols/Connector.kicad_sym", name="USB_C_Receptacle_USB2.0_16P"),
    footprint=File("@kicad-footprints/Connector_USB.pretty/USB_C_Receptacle_G-Switch_GT-USB-7010ASV.kicad_mod"),
    pins={
        "CC1": CC1,
        "CC2": CC2,
        "D-": USB2C.D.N,
        "D+": USB2C.D.P,
        "SHIELD": GND,
        "GND": GND,
        "SBU1": Net("SBU1"),
        "SBU2": Net("SBU2"),
        "VBUS": V5,
    },
    mpn="GT-USB-7010ASV",
    properties={
        "value": "GT-USB-7010ASV",
        "manufacturer": "G-Switch",
        "LCSC Part": "C2988369",
        "description": "USB-C Receptacle USB2.0 16P Top Mount Horizontal",
        "datasheet": "https://www.lcsc.com/datasheet/C2988369.pdf/",
        "alternatives": [
            {"mpn": "USB4105-GF-A", "manufacturer": "GCT"},
        ],
    },
)

VoltageClamp(
    name="Voltage_Clamp",
    K1=USB2C.D.N,
    K2=USB2C.D.P,
    A=GND,
)

Resistor(
    name="R_VBUS",
    value="2.2kohms",
    package="0402",
    P1=V5,
    P2=GND,
)

Capacitor(
    name="C_VBUS1",
    value="100nF",
    package="0402",
    voltage="16V",
    dielectric="X7R",
    P1=V5,
    P2=GND,
)

Capacitor(
    name="C_VBUS2",
    value="100nF",
    package="0402",
    voltage="16V",
    dielectric="X7R",
    P1=V5,
    P2=GND,
)

