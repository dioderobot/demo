"""
CM5 - CM5 Carrier
Author: Nasheed Ur Rehman
"""

# ----------------------------------------------------------------------------
# Libraries & Dependencies
# ----------------------------------------------------------------------------

load(
    "@stdlib/interfaces.zen",
    "Ethernet_Phy",
    "Ground",
    "Hdmi",
    "I2c",
    "Mipi",
    "PcieGen3x1Lane",
    "Power",
    "NotConnected",
    "Spi",
    "Usb2",
    "Usb3",
)
load("@stdlib/units.zen", "Capacitance", "Current", "Frequency", "Inductance", "Resistance", "Voltage")

# ----------------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Component Modules
# ----------------------------------------------------------------------------

CM5IO = Module("github.com/dioderobot/demo/reference/RP_CM5_IO/CM5_IO.zen")
JST_BATT = Module(
    "github.com/dioderobot/demo/components/JST_JAPAN_SOLDERLESS_TERMINALS/SM02BMSRSSMTB_LF_SN/SM02BMSRSSMTB_LF_SN.zen"
)

# ----------------------------------------------------------------------------
# Component Mapping
# ----------------------------------------------------------------------------

# Power Pins
V5V_IN = io("CM5_5V_IN", Net)
V3V3_CM5 = io("CM5_3V3", Net)
V1V8_CM5 = io("CM5_1V8", Net)
GND = io(Ground)
GPIO_VREF = io(Net)

# MIPI Interface
MIPI0_C = io("DPHY0_P", Mipi)

# HDMI Interface
HDMI_PI = io(Hdmi)

# USB2 Interface
USB3P = io(Usb3)
USB_PI = io(Usb2)
USBOTG_ID = io(Net)

# PCIe Interface
PCIE_PI = io(PcieGen3x1Lane)
PCIE_PI_PWR_EN = io(Net)

# SPI Interface
SPI_PI = io(Spi)

# I2C/SPI Interfaces
I2C0 = io(I2c)
I2C1 = io(I2c)

# GPIO Pins
DC_GPI25 = io(Net)
BL_GPIO24 = io(Net)
RST_GPIO27 = io(Net)

# ID Pins
ID_SC = io(Net)
ID_SD = io(Net)

# Ethernet Interface
ETH_PI = io(Ethernet_Phy)
ETH_NLED_ACTIVITY = io(Net)
N_LED_SPEED_100_1000 = io(Net)

# Camera Control
CAM_GPIO0 = io(Net)
CAM_GPIO1 = io(Net)

# Other Interfaces
CC1 = io(Net)
CC2 = io(Net)
EEPROM_NWP = io(Net)
FAN_PWM = io(Net)
FAN_TACHO = io(Net)
N_LED_ACTIVITY = io(Net)
PI_NLED_PWR = io(Net)
GLOBAL_EN = io(Net)
PWR_BUT = io(Net)
VBUS_EN = io(Net)
N_RPIBOOT = io(Net)

# ----------------------------------------------------------------------------
# Local Nets
# ----------------------------------------------------------------------------

BATT = Power()

# ----------------------------------------------------------------------------
# ComponentS
# ----------------------------------------------------------------------------

CM5IO(
    name="CM5IO",
    GND=GND,
    V1V8_OUTPUT=V1V8_CM5,
    V3V3_OUTPUT=V3V3_CM5,
    V5V_INPUT=V5V_IN,
    # GPIO Interface
    GPIO_VREF_1V8_3V3_INPUT=GPIO_VREF,
    GPIO2=I2C1.SDA,
    GPIO3=I2C1.SCL,
    GPIO4=NotConnected(),
    GPIO5=NotConnected(),
    GPIO6=NotConnected(),
    GPIO7=NotConnected(),
    GPIO8=NotConnected(),
    GPIO9=NotConnected(),
    GPIO10=NotConnected(),
    GPIO11=NotConnected(),
    GPIO12=NotConnected(),
    GPIO13=NotConnected(),
    GPIO14=NotConnected(),
    GPIO15=NotConnected(),
    GPIO16=NotConnected(),
    GPIO17=NotConnected(),
    GPIO18=SPI_PI.CS,
    GPIO19=SPI_PI.MISO,
    GPIO20=SPI_PI.MOSI,
    GPIO21=SPI_PI.CLK,
    GPIO22=NotConnected(),
    GPIO23=NotConnected(),
    GPIO24=BL_GPIO24,
    GPIO25=DC_GPI25,
    GPIO26=NotConnected(),
    GPIO27=RST_GPIO27,
    VBAT=BATT,
    # Ethernet Interface
    ETHERNET_PAIR0_N=ETH_PI.TR0.N,
    ETHERNET_PAIR0_P=ETH_PI.TR0.P,
    ETHERNET_PAIR1_N=ETH_PI.TR1.N,
    ETHERNET_PAIR1_P=ETH_PI.TR1.P,
    ETHERNET_PAIR2_N=ETH_PI.TR2.N,
    ETHERNET_PAIR2_P=ETH_PI.TR2.P,
    ETHERNET_PAIR3_N=ETH_PI.TR3.N,
    ETHERNET_PAIR3_P=ETH_PI.TR3.P,
    ETHERNET_SYNC_OUT_3V3=NotConnected(),
    ETHERNET_NLED2_3V3=N_LED_SPEED_100_1000,
    ETHERNET_NLED3_3V3=ETH_NLED_ACTIVITY,
    # HDMI Interface
    HDMI0_CEC=HDMI_PI.CEC,
    HDMI0_CLK_N=HDMI_PI.CLK.N,
    HDMI0_CLK_P=HDMI_PI.CLK.P,
    HDMI0_HOTPLUG=HDMI_PI.HPD,
    HDMI0_SCL=HDMI_PI.SCL,
    HDMI0_SDA=HDMI_PI.SDA,
    HDMI0_TX0_N=HDMI_PI.D0.N,
    HDMI0_TX0_P=HDMI_PI.D0.P,
    HDMI0_TX1_N=HDMI_PI.D1.N,
    HDMI0_TX1_P=HDMI_PI.D1.P,
    HDMI0_TX2_N=HDMI_PI.D2.N,
    HDMI0_TX2_P=HDMI_PI.D2.P,
    # HDMI1 Interface
    HDMI1_CEC=NotConnected(),
    HDMI1_CLK_N=NotConnected(),
    HDMI1_CLK_P=NotConnected(),
    HDMI1_HOTPLUG=NotConnected(),
    HDMI1_SCL=NotConnected(),
    HDMI1_SDA=NotConnected(),
    HDMI1_TX0_N=NotConnected(),
    HDMI1_TX0_P=NotConnected(),
    HDMI1_TX1_N=NotConnected(),
    HDMI1_TX1_P=NotConnected(),
    HDMI1_TX2_N=NotConnected(),
    HDMI1_TX2_P=NotConnected(),
    # CC Interface
    CC1=CC1,
    CC2=CC2,
    # USB Interface
    USB2_N=USB_PI.D.N,
    USB2_P=USB_PI.D.P,
    # USB3 Interface
    USB3_0_D_N=USB3P.D.N,
    USB3_0_D_P=USB3P.D.P,
    USB3_0_RX_N=USB3P.SSRX.N,
    USB3_0_RX_P=USB3P.SSRX.P,
    USB3_0_TX_N=USB3P.SSTX.N,
    USB3_0_TX_P=USB3P.SSTX.P,
    USB3_1_D_N=NotConnected(),
    USB3_1_D_P=NotConnected(),
    USB3_1_RX_N=NotConnected(),
    USB3_1_RX_P=NotConnected(),
    USB3_1_TX_N=NotConnected(),
    USB3_1_TX_P=NotConnected(),
    # USB OTG Interface
    USB_OTG_ID=USBOTG_ID,
    # PCIe Interface
    PCIE_PWR_EN=PCIE_PI_PWR_EN,
    PCIE_NWAKE=PCIE_PI.WAKE_N,
    PCIE_CLK_N=PCIE_PI.REFCLK.N,
    PCIE_CLK_P=PCIE_PI.REFCLK.P,
    PCIE_RX_N=PCIE_PI.RX.N,
    PCIE_RX_P=PCIE_PI.RX.P,
    PCIE_TX_N=PCIE_PI.TX.N,
    PCIE_TX_P=PCIE_PI.TX.P,
    PCIE_NCLKREQ=PCIE_PI.CLK_REQ_N,
    PCIE_NRST=PCIE_PI.RESET_N,
    # MIPI Interface
    MIPI0_C_N=MIPI0_C.CLK.N,
    MIPI0_C_P=MIPI0_C.CLK.P,
    MIPI0_D0_N=MIPI0_C.DATA0.N,
    MIPI0_D0_P=MIPI0_C.DATA0.P,
    MIPI0_D1_N=MIPI0_C.DATA1.N,
    MIPI0_D1_P=MIPI0_C.DATA1.P,
    MIPI0_D2_N=MIPI0_C.DATA2.N,
    MIPI0_D2_P=MIPI0_C.DATA2.P,
    MIPI0_D3_N=MIPI0_C.DATA3.N,
    MIPI0_D3_P=MIPI0_C.DATA3.P,
    # MIPI1 Interface
    MIPI1_C_N=NotConnected(),
    MIPI1_C_P=NotConnected(),
    MIPI1_D0_N=NotConnected(),
    MIPI1_D0_P=NotConnected(),
    MIPI1_D1_N=NotConnected(),
    MIPI1_D1_P=NotConnected(),
    MIPI1_D2_N=NotConnected(),
    MIPI1_D2_P=NotConnected(),
    MIPI1_D3_N=NotConnected(),
    MIPI1_D3_P=NotConnected(),
    # SD Interface
    SD_CLK=NotConnected(),
    SD_CMD=NotConnected(),
    SD_DAT0=NotConnected(),
    SD_DAT1=NotConnected(),
    SD_DAT2=NotConnected(),
    SD_DAT3=NotConnected(),
    SD_DAT4=NotConnected(),
    SD_DAT5=NotConnected(),
    SD_DAT6=NotConnected(),
    SD_DAT7=NotConnected(),
    SD_PWR_ON=NotConnected(),
    SD_VDD_OVERRIDE=NotConnected(),
    # Camera Interface
    CAM_GPIO0=CAM_GPIO0,
    CAM_GPIO1=CAM_GPIO1,
    SCL0=I2C0.SCL,
    SDA0=I2C0.SDA,
    # Other Interfaces
    BT_NDISABLE=NotConnected(),
    EEPROM_NWP=EEPROM_NWP,
    FAN_PWM=FAN_PWM,
    FAN_TACHO=FAN_TACHO,
    ID_SC=ID_SC,
    ID_SD=ID_SD,
    LED_NACT=N_LED_ACTIVITY,
    LED_NPWR=PI_NLED_PWR,
    PMIC_ENABLE=GLOBAL_EN,
    PWR_BUT=PWR_BUT,
    VBUS_EN=VBUS_EN,
    WIFI_NDISABLE=NotConnected(),
    N_RPIBOOT=N_RPIBOOT,
)

JST_BATT(
    name="JST_BATT",
    P1=BATT,
    P2=GND,
    MP1=GND,
    MP2=GND,
)

