"""
HDMI - CM5 Carrier
Author: Nasheed Ur Rehman
"""

# ----------------------------------------------------------------------------
# Libraries & Dependencies
# ----------------------------------------------------------------------------

load("@stdlib/config.zen", "config_properties")
load("@stdlib/interfaces.zen", "Hdmi", "Power", "Ground", "NotConnected")
load("@stdlib/properties.zen", "Layout")
load("@stdlib/units.zen", "Capacitance", "Current", "Frequency", "Inductance", "Resistance", "Voltage")

# ----------------------------------------------------------------------------
# Component Modules
# ----------------------------------------------------------------------------

HDMI_Connector = Module("github.com/dioderobot/demo/components/XUNPU/HDMI-101S/HDMI-101S.zen")
ESD_Protection = Module("github.com/dioderobot/demo/components/Nexperia/PUSB3F96X/PUSB3F96X.zen")
Current_Limit_Switch = Module("github.com/dioderobot/demo/reference/STMPS2151STR/STMPS2151STR.zen")

# ----------------------------------------------------------------------------
# io_interfaces
# ----------------------------------------------------------------------------

io_5v = io("io_5v", Power)
io_gnd = io("io_gnd", Ground)
hdmi_c = io("HDMI_C", Hdmi)

# ----------------------------------------------------------------------------
# Local nets
# ----------------------------------------------------------------------------

hdmi_5v = Power("hdmi_5v")

# ----------------------------------------------------------------------------
# Components
# ----------------------------------------------------------------------------

HDMI_Connector(
    name="HDMI_Connector",
    P5V=hdmi_5v,
    CEC=hdmi_c.CEC,
    DDC_CEC_GND=io_gnd,
    HOT_PLUG_DET=hdmi_c.HPD,
    SCL=hdmi_c.SCL,
    SDA=hdmi_c.SDA,
    SHIELD=io_gnd,
    TMDS_CLOCKM=hdmi_c.CLK.N,
    TMDS_CLOCKP=hdmi_c.CLK.P,
    TMDS_CLOCK_SHIELD=io_gnd,
    TMDS_DATA0M=hdmi_c.D0.N,
    TMDS_DATA0P=hdmi_c.D0.P,
    TMDS_DATA0_SHIELD=io_gnd,
    TMDS_DATA1M=hdmi_c.D1.N,
    TMDS_DATA1P=hdmi_c.D1.P,
    TMDS_DATA1_SHIELD=io_gnd,
    TMDS_DATA2M=hdmi_c.D2.N,
    TMDS_DATA2P=hdmi_c.D2.P,
    TMDS_DATA2_SHIELD=io_gnd,
    UTILITY=NotConnected(),
)

Current_Limit_Switch(
    name="Current_Limit_Switch",
    vin=io_5v,
    vout=hdmi_5v,
    gnd=io_gnd,
    enable=io_5v,
    fault=Net("fault"),
)

