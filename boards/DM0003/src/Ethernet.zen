"""
Ethernet - CM5 Carrier
Author: Nasheed Ur Rehman
"""

# ----------------------------------------------------------------------------
# Libraries & Dependencies
# ----------------------------------------------------------------------------

load("@stdlib/interfaces.zen", "Ethernet_Phy", "Power", "Ground", "NotConnected")
load("@stdlib/properties.zen", "Layout")
load("@stdlib/units.zen", "Capacitance", "Current", "Frequency", "Inductance", "Resistance", "Voltage")

# ----------------------------------------------------------------------------
# Component Modules
# ----------------------------------------------------------------------------

Ethernet = Module("github.com/diodeinc/registry/components/SkyMirr/CRJ009-ML4-TH/CRJ009-ML4-TH.zen")
QuadTVS = Module("github.com/dioderobot/demo/components/Texas_Instruments/TPD4EUSB30DQAR/TPD4EUSB30DQAR.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")
Led = Module("@stdlib/generics/Led.zen")

# ----------------------------------------------------------------------------
# io_interfaces
# ----------------------------------------------------------------------------

V3V3PI = io("3V3PI", Power)
GND = io("GND", Ground)

ETH_C = io("ETH_C", Ethernet_Phy)

NLED_Y = io("NLED_Y", Net)
NLED_G = io("NLED_G", Net)

# ----------------------------------------------------------------------------
# local nets
# ----------------------------------------------------------------------------

VCC = Net("VCC")
MP = Net("MP")

ETHERNET_A_GREEN = Net("A_GREEN")
ETHERNET_A_YELLOW = Net("A_YELLOW")
ETHERNET_K_GREEN = Net("K_GREEN")
ETHERNET_K_YELLOW = Net("K_YELLOW")

# ----------------------------------------------------------------------------
# Component Instances
# ----------------------------------------------------------------------------

Ethernet(
    name="ETH",
    A_GREEN=V3V3PI,
    A_YELLOW=V3V3PI,
    K_GREEN=ETHERNET_K_GREEN,
    K_YELLOW=ETHERNET_K_YELLOW,
    MH1=MP,
    MH2=MP,
    NC_1=NotConnected(),
    NC_2=NotConnected(),
    TRD0_POS=ETH_C.TR0.P,
    TRD0_NEG=ETH_C.TR0.N,
    TRD1_POS=ETH_C.TR1.P,
    TRD1_NEG=ETH_C.TR1.N,
    TRD2_POS=ETH_C.TR2.P,
    TRD2_NEG=ETH_C.TR2.N,
    TRD3_POS=ETH_C.TR3.P,
    TRD3_NEG=ETH_C.TR3.N,
)

QuadTVS(
    name="TVS_0",
    D1M=ETH_C.TR0.N,
    D1P=ETH_C.TR0.P,
    D2M=ETH_C.TR1.N,
    D2P=ETH_C.TR1.P,
    GND=GND,
)

QuadTVS(
    name="TVS_1",
    D1M=ETH_C.TR2.N,
    D1P=ETH_C.TR2.P,
    D2M=ETH_C.TR3.N,
    D2P=ETH_C.TR3.P,
    GND=GND,
)

Resistor(
    name="R1",
    value="0ohms",
    package="0402",
    P1=MP,
    P2=GND,
)

# Capacitor(
#     name = "C1",
#     value = "100nF",
#     package = "0402",
#     P1 = vcc,
#     P2 = io_gnd,
# )

Resistor(
    name="R_LED_Y",
    value="470ohms",
    package="0402",
    P1=ETHERNET_K_GREEN,
    P2=NLED_Y,
)

Resistor(
    name="R_LED_G",
    value="470ohms",
    package="0402",
    P1=ETHERNET_K_YELLOW,
    P2=NLED_G,
)

Layout("layout", "layout_Ethernet/")

