"""
DM0003 - Raspberry Pi CM5 Carrier Board
Author: Nasheed Ur Rehman
"""

# ----------------------------------------------------------------------------
# Libraries & Dependencies
# ----------------------------------------------------------------------------

load(
    "@stdlib/interfaces.zen",
    "Ethernet_Phy",
    "Hdmi",
    "I2c",
    "Mipi",
    "PcieGen3x1Lane",
    "Power",
    "Ground",
    "NotConnected",
    "Spi",
    "Usb2",
    "Usb3",
)
load("@stdlib/units.zen", "Capacitance", "Current", "Frequency", "Resistance", "Voltage")
load("@stdlib/board_config.zen", "Board")

# ----------------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Component Modules
# ----------------------------------------------------------------------------

IO = Module("src/IO.zen")
USBPI = Module("src/USB_PI.zen")
USB3PI = Module("src/USB_3PI.zen")
CM5 = Module("src/CM5.zen")
HDMI = Module("src/HDMI.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")
PCIe_M2 = Module("src/PCIe-M2.zen")
DSI_CSI = Module("src/DSI_CSI.zen")
Ethernet = Module("src/Ethernet.zen")
Boot_Switch = Module("github.com/dioderobot/demo/components/G_Switch/MKM11C04MG013/MKM11C04MG013.zen")
Version = Module("@stdlib/generics/Version.zen")

# Graphics Components
Cat_Logo = Module("src/graphics/Cat_Logo.zen")
Heart_Logo = Module("src/graphics/Heart_Logo.zen")
Diode_Logo = Module("src/graphics/Diode_Logo.zen")

# ----------------------------------------------------------------------------
# io_interfaces
# ----------------------------------------------------------------------------

V5 = Power("5V", voltage=Voltage("5V"))
V3V3PI = Power("3V3PI", voltage=Voltage("3.3V"))
V1V8 = Power("1V8", voltage=Voltage("1.8V"))
GND = Ground()
GPIO_VREF = Net()

DPHY0_P = io(Mipi)
HDMI_PI = io(Hdmi)

USB_3P = io("USB3P", Usb3)
USB_PI = io(Usb2)
USBOTG_ID = NotConnected()

PCIE_PI = io(PcieGen3x1Lane)
PCIE_PI_PWR_EN = io(Net)

ETH_C = io(Ethernet_Phy)
ETH_NLED_ACTIVITY = io(Net)
N_LED_SPEED_100_1000 = io(Net)

SPI_C = io(Spi)

I2C0 = io(I2c)
I2C1 = io(I2c)

DC_GPI25 = io(Net)
BL_GPIO24 = io(Net)
RST_GPIO27 = io(Net)

ID_SC = NotConnected()
ID_SD = NotConnected()

CAM_GPIO0 = io(Net)
CAM_GPIO1 = io(Net)

CC1 = io(Net)
CC2 = io(Net)

EEPROM_NWP = io(Net)
FAN_PWM = io(Net)
FAN_TACHO = io(Net)
N_LED_ACTIVITY = io(Net)
PI_NLED_PWR = io(Net)
GLOBAL_EN = io(Net)
PWR_BUT = io(Net)
VBUS_EN = io(Net)
N_RPIBOOT = io(Net)

CM5(
    name="CM5",
    DPHY0_P=DPHY0_P,
    HDMI_PI=HDMI_PI,
    USB3P=USB_3P,
    USB_PI=USB_PI,
    USBOTG_ID=USBOTG_ID,
    PCIE_PI=PCIE_PI,
    PCIE_PI_PWR_EN=PCIE_PI_PWR_EN,
    SPI_PI=SPI_C,
    I2C0=I2C0,
    I2C1=I2C1,
    GND=GND,
    CM5_1V8=V1V8,
    CM5_3V3=V3V3PI,
    CM5_5V_IN=V5,
    GPIO_VREF=GPIO_VREF,
    DC_GPI25=DC_GPI25,
    BL_GPIO24=BL_GPIO24,
    RST_GPIO27=RST_GPIO27,
    ID_SC=ID_SC,
    ID_SD=ID_SD,
    ETH_PI=ETH_C,
    ETH_NLED_ACTIVITY=ETH_NLED_ACTIVITY,
    N_LED_SPEED_100_1000=N_LED_SPEED_100_1000,
    CAM_GPIO0=CAM_GPIO0,
    CAM_GPIO1=CAM_GPIO1,
    CC1=CC1,
    CC2=CC2,
    EEPROM_NWP=EEPROM_NWP,
    FAN_PWM=FAN_PWM,
    FAN_TACHO=FAN_TACHO,
    N_LED_ACTIVITY=N_LED_ACTIVITY,
    PI_NLED_PWR=PI_NLED_PWR,
    GLOBAL_EN=GLOBAL_EN,
    PWR_BUT=PWR_BUT,
    VBUS_EN=VBUS_EN,
    N_RPIBOOT=N_RPIBOOT,
    schematic="collapse",
)

Ethernet(
    name="Ethernet",
    ETH_C=ETH_C,
    NLED_G=ETH_NLED_ACTIVITY,
    NLED_Y=N_LED_SPEED_100_1000,
    schematic="collapse",
    **{"3V3PI": V3V3PI, "GND": GND},
)

HDMI(
    name="HDMI",
    HDMI_C=HDMI_PI,
    schematic="collapse",
    **{"5V": V5, "GND": GND},
)

USBPI(
    name="USB_PI",
    USB_PI=USB_PI,
    CC1=CC1,
    CC2=CC2,
    schematic="collapse",
    **{"5V": V5, "GND": GND},
)

USB3PI(
    name="USB_3PI",
    V5V=V5,
    V3V3=V3V3PI,
    GND=GND,
    VBUS_EN=VBUS_EN,
    USB_3PI=USB_3P,
    schematic="collapse",
)

PCIe_M2(
    name="PCIE_M2",
    PCIE_C=PCIE_PI,
    PCIE_PWR_EN=PCIE_PI_PWR_EN,
    schematic="collapse",
    **{"5V": V5, "GND": GND},
)

DSI_CSI(
    name="DSI_CSI",
    DPHY0_C=DPHY0_P,
    CAM_GPIO0=CAM_GPIO0,
    CAM_GPIO1=CAM_GPIO1,
    I2C=I2C0,
    schematic="collapse",
    **{"3V3PI": V3V3PI, "GND": GND},
)

IO(
    name="IO",
    SPI=SPI_C,
    I2C=I2C1,
    BL=BL_GPIO24,
    RST=RST_GPIO27,
    DC=DC_GPI25,
    FAN_PWM=FAN_PWM,
    FAN_TACHO=FAN_TACHO,
    N_PWR_LED=PI_NLED_PWR,
    N_LED_ACTIVITY=N_LED_ACTIVITY,
    PWR_BUT=PWR_BUT,
    schematic="collapse",
    **{"5V": V5, "3V3PI": V3V3PI, "GND": GND},
)

Resistor(
    name="R_EEPROM_WP",
    value="10kohms",
    package="0402",
    P1=EEPROM_NWP,
    P2=GND,
)

Resistor(
    name="R_GPIO_VREF_3V3",
    value="0ohms",
    package="0402",
    P1=GPIO_VREF,
    P2=V3V3PI,
)

Resistor(
    name="R_GPIO_VREF_1V8",
    value="0ohms",
    package="0402",
    dnp=True,
    P1=GPIO_VREF,
    P2=V1V8,
)

Boot_Switch(
    name="BOOT_SWITCH",
    COM=N_RPIBOOT,
    MP1=GND,
    MP2=GND,
    NO=GND,
)

# Graphics Components

Cat_Logo(
    name="CAT_LOGO",
)

Heart_Logo(
    name="HEART_LOGO",
)

Diode_Logo(
    name="DIODE_LOGO",
)

Version(
    name="Version",
)

Board(name="DM0003", layout_path="layout/DM0003", layers=6)

