"""
DM0003 - Raspberry Pi CM5 Carrier Board
Author: Nasheed Ur Rehman
"""

# ----------------------------------------------------------------------------
# Libraries & Dependencies
# ----------------------------------------------------------------------------

load(
    "@stdlib/interfaces.zen",
    "Ethernet_Phy",
    "Hdmi",
    "I2c",
    "Mipi",
    "PcieGen3x1Lane",
    "Power",
    "Ground",
    "Spi",
    "Usb2",
    "Usb3",
)
load("@stdlib/units.zen", "Capacitance", "Current", "Frequency", "Resistance", "Voltage")
load("@stdlib/board_config.zen", "Board")

# ----------------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Component Modules
# ----------------------------------------------------------------------------

IO = Module("src/IO.zen")
USBPI = Module("src/USB_PI.zen")
USB3PI = Module("src/USB_3PI.zen")
CM5 = Module("src/CM5.zen")
HDMI = Module("src/HDMI.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")
PCIe_M2 = Module("src/PCIe-M2.zen")
DSI_CSI = Module("src/DSI_CSI.zen")
Ethernet = Module("src/Ethernet.zen")
Boot_Switch = Module("github.com/dioderobot/demo/components/G_Switch/MKM11C04MG013/MKM11C04MG013.zen")
Version = Module("@stdlib/generics/Version.zen")

# Graphics Components
Cat_Logo = Module("src/graphics/Cat_Logo.zen")
Heart_Logo = Module("src/graphics/Heart_Logo.zen")
Diode_Logo = Module("src/graphics/Diode_Logo.zen")

# ----------------------------------------------------------------------------
# io_interfaces
# ----------------------------------------------------------------------------

io_5v = Power("5v", voltage=Voltage("5V"))
io_3v3pi = Power("3v3pi", voltage=Voltage("3.3V"))
io_1v8 = Power("1v8", voltage=Voltage("1.8V"))
io_gnd = Ground("gnd")
io_gpio_vref = Net("gpio_vref")

DPHY0_P = io("DPHY0_P", Mipi)
HDMI_PI = io("HDMI_PI", Hdmi)

USB_3P = io("USB3P", Usb3)
USB_PI = io("USB_PI", Usb2)
USBOTG_ID = Net("NC")

PCIE_PI = io("PCIE_PI", PcieGen3x1Lane)
PCIE_PI_PWR_EN = io("PCIE_PI_PWR_EN", Net)

ETH_C = io("ETH_C", Ethernet_Phy)
ETH_nLED_ACTIVITY = io("ETH_nLED_ACTIVITY", Net)
nLED_SPEED_100_1000 = io("nLED_SPEED_100_1000", Net)

SPI_C = io("SPI_C", Spi)

I2C0 = io("I2C0", I2c)
I2C1 = io("I2C1", I2c)

DC_GPI25 = io("DC_GPI25", Net)
BL_GPIO24 = io("BL_GPIO24", Net)
RST_GPIO27 = io("RST_GPIO27", Net)

ID_SC = Net("NC")
ID_SD = Net("NC")

CAM_GPIO0 = io("CAM_GPIO0", Net)
CAM_GPIO1 = io("CAM_GPIO1", Net)

CC1 = io("CC1", Net)
CC2 = io("CC2", Net)

EEPROM_nWP = io("EEPROM_nWP", Net)
FAN_PWM = io("FAN_PWM", Net)
FAN_TACHO = io("FAN_TACHO", Net)
nLED_ACTIVITY = io("nLED_ACTIVITY", Net)
PI_nLED_PWR = io("PI_nLED_PWR", Net)
GLOBAL_EN = io("GLOBAL_EN", Net)
PWR_BUT = io("PWR_BUT", Net)
VBUS_EN = io("VBUS_EN", Net)
nRPIBOOT = io("nRPIBOOT", Net)

CM5(
    name="CM5",
    DPHY0_P=DPHY0_P,
    HDMI_PI=HDMI_PI,
    USB3P=USB_3P,
    USB_PI=USB_PI,
    USBOTG_ID=USBOTG_ID,
    PCIE_PI=PCIE_PI,
    PCIE_PI_PWR_EN=PCIE_PI_PWR_EN,
    SPI_PI=SPI_C,
    I2C0=I2C0,
    I2C1=I2C1,
    GND=io_gnd,
    CM5_1V8=io_1v8,
    CM5_3V3=io_3v3pi,
    CM5_5V_IN=io_5v,
    GPIO_VREF=io_gpio_vref,
    DC_GPI25=DC_GPI25,
    BL_GPIO24=BL_GPIO24,
    RST_GPIO27=RST_GPIO27,
    ID_SC=ID_SC,
    ID_SD=ID_SD,
    ETH_PI=ETH_C,
    ETH_nLED_ACTIVITY=ETH_nLED_ACTIVITY,
    nLED_SPEED_100_1000=nLED_SPEED_100_1000,
    CAM_GPIO0=CAM_GPIO0,
    CAM_GPIO1=CAM_GPIO1,
    CC1=CC1,
    CC2=CC2,
    EEPROM_nWP=EEPROM_nWP,
    FAN_PWM=FAN_PWM,
    FAN_TACHO=FAN_TACHO,
    nLED_ACTIVITY=nLED_ACTIVITY,
    PI_nLED_PWR=PI_nLED_PWR,
    GLOBAL_EN=GLOBAL_EN,
    PWR_BUT=PWR_BUT,
    VBUS_EN=VBUS_EN,
    nRPIBOOT=nRPIBOOT,
    schematic="collapse",
)

Ethernet(
    name="Ethernet",
    ETH_C=ETH_C,
    nLed_G=ETH_nLED_ACTIVITY,
    nLed_Y=nLED_SPEED_100_1000,
    schematic="collapse",
    **{"3v3pi": io_3v3pi, "gnd": io_gnd},
)

HDMI(
    name="HDMI",
    HDMI_C=HDMI_PI,
    schematic="collapse",
    **{"5v": io_5v, "gnd": io_gnd},
)

USBPI(
    name="USB_PI",
    USB_PI=USB_PI,
    CC1=CC1,
    CC2=CC2,
    schematic="collapse",
    **{"5v": io_5v, "gnd": io_gnd},
)

USB3PI(
    name="USB_3PI",
    V5V=io_5v,
    V3V3=io_3v3pi,
    GND=io_gnd,
    VBUS_EN=VBUS_EN,
    USB_3PI=USB_3P,
    schematic="collapse",
)

PCIe_M2(
    name="PCIE_M2",
    PCIE_C=PCIE_PI,
    PCIE_PWR_EN=PCIE_PI_PWR_EN,
    schematic="collapse",
    **{"5v": io_5v, "gnd": io_gnd},
)

DSI_CSI(
    name="DSI_CSI",
    DPHY0_C=DPHY0_P,
    cam_gpio0=CAM_GPIO0,
    cam_gpio1=CAM_GPIO1,
    i2c=I2C0,
    schematic="collapse",
    **{"3v3pi": io_3v3pi, "gnd": io_gnd},
)

IO(
    name="IO",
    spi=SPI_C,
    i2c=I2C1,
    bl=BL_GPIO24,
    rst=RST_GPIO27,
    dc=DC_GPI25,
    fan_pwm=FAN_PWM,
    fan_tacho=FAN_TACHO,
    nPWR_LED=PI_nLED_PWR,
    nLED_ACTIVITY=nLED_ACTIVITY,
    nRESET=GLOBAL_EN,
    pwr_but=PWR_BUT,
    schematic="collapse",
    **{"5v": io_5v, "3v3pi": io_3v3pi, "gnd": io_gnd},
)

Resistor(
    name="R_EEPROM_WP",
    value="10kohms",
    package="0402",
    P1=EEPROM_nWP,
    P2=io_gnd,
)

Resistor(
    name="R_GPIO_VREF_3V3",
    value="0ohms",
    package="0402",
    P1=io_gpio_vref,
    P2=io_3v3pi,
)

Resistor(
    name="R_GPIO_VREF_1V8",
    value="0ohms",
    package="0402",
    dnp=True,
    P1=io_gpio_vref,
    P2=io_1v8,
)

Boot_Switch(
    name="BOOT_SWITCH",
    COM=nRPIBOOT,
    MP1=io_gnd,
    MP2=io_gnd,
    NO=io_gnd,
    NC=Net("NC"),
)

# Graphics Components

Cat_Logo(
    name="CAT_LOGO",
)

Heart_Logo(
    name="HEART_LOGO",
)

Diode_Logo(
    name="DIODE_LOGO",
)

Version(
    name="Version",
)

Board(name="DM0003", layout_path="layout/DM0003", layers=6)

