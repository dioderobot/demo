"""
Feign — DM0004 — USB-C to UART bridge.

STM32G0B1-based software FTDI clone. Bus-powered, crystal-less USB
(HSI48 + CRS). Composite CDC-ACM + FTDI UART-mode emulation.
"""

load("@stdlib/interfaces.zen", "NotConnected", "Swd", "Uart", "UsbTypeC")

UsbCSink = Module("github.com/diodeinc/registry/modules/UsbCSink16P/UsbCSink16P.zen")
STM32G0B1 = Module("github.com/diodeinc/registry/components/STMicroelectronics/STM32G0B1KxUxN/STM32G0B1KxUxN.zen")
LDO = Module("github.com/diodeinc/registry/components/Texas_Instruments/TPS74x01P/TPS74x01P.zen")
LoadSwitch = Module("github.com/diodeinc/registry/components/Texas_Instruments/TPS2553DRV/TPS2553DRV.zen")
Button = Module("github.com/diodeinc/registry/components/B3U-1000P/B3U-1000P.zen")
PinHeader = Module("github.com/diodeinc/registry/components/Harwin_Inc/M20-889xx45/M20-889xx45.zen")
TagConnect = Module("github.com/diodeinc/registry/connectors/TagConnect/TC2030_SWD.zen")

Resistor = Module("@stdlib/generics/Resistor.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")
Led = Module("@stdlib/generics/Led.zen")


def led(name, anode, color, resistance):
    """LED + series current-limit resistor to GND. `anode` drives the LED high."""
    K = Net("LED_" + name + "_K")
    Led(name="D_" + name, color=color, package="0402", A=anode, K=K)
    Resistor(name="R_" + name, value=resistance, package="0402", P1=K, P2=GND)

VBUS = Power(voltage="4.5V to 5.5V (5V nom.)")
V3V3 = Power(voltage="3.3V")
VCC_OUT = Power(voltage="4.5V to 5.5V (5V nom.)")
GND = Ground()

USB_C = UsbTypeC()
UART = Uart()  # PD3 TX → header TXD ; PD2 RX ← header RXD (FT_c, 5V tolerant)
SWD = Swd()    # PA13 SWDIO ; PA14 SWCLK (also BOOT0)

NRST = Net()
PG = Net()  # LDO power-good → power LED
VCC_EN = Net()
VCC_FAULT = Net()
MODEM_CTS = Net()  # PD0 (FT_c, 5V tolerant)
MODEM_DTR = Net()  # PD1 output
LED_TX = Net()
LED_RX = Net()

# USB-C front-end (connector + ESD + VBUS TVS, CC pulldowns DNP)
UsbCSink(
    name="J_USB",
    cc_resistors=False,  # STM32G0B1 UCPD dead-battery Rd handles termination
    tvs=True,
    USB_C=USB_C,
    VBUS=VBUS,
    GND=GND,
)

# VBUS bulk — USB 2.0 §7.2.4.1 caps a FS device at ≤10 µF effective.
# UsbCSink16P does not include VBUS bulk; the LDO and load-switch packages
# each add 1 µF C_IN, so total nominal is ~6.7 µF (within USB-spec window
# after MLCC DC-bias derating).
Capacitor(name="C_VBUS_BULK", value="4.7uF", package="0805", P1=VBUS, P2=GND)

# 3V3 LDO — TPS74x01P (push-pull PG drives power LED directly)
LDO(
    name="U_LDO",
    output_voltage="3.3V",
    output_current="500mA",
    pg_type="PushPull",
    VIN=VBUS,
    VOUT=V3V3,
    GND=GND,
    PG=PG,
)

# Power LED — on when LDO PG asserted (rail healthy)
led("PWR", PG, "green", "1kohm")

LoadSwitch(
    name="U_VCC_SW",
    current_limit="400mA",  # leaves ~100 mA headroom within the USB 500 mA budget
    overcurrent_response="ConstantCurrent",
    VIN=VBUS,
    VOUT=VCC_OUT,
    GND=GND,
    EN=VCC_EN,
    FAULT=VCC_FAULT,
)

# FAULT open-drain pull-up to 3V3.
Resistor(name="R_VCC_FAULT", value="100kohm", package="0402", P1=VCC_FAULT, P2=V3V3)

# EN pull-down keeps the switch deterministically OFF during MCU reset/boot
# (G0 GPIOs default to high-Z analog input on POR).
Resistor(name="R_VCC_EN", value="100kohm", package="0402", P1=VCC_EN, P2=GND)

# MCU — STM32G0B1KxUxN (UFQFPN-32 N-pinout, UCPD with dead-battery Rd)
STM32G0B1(
    name="U_MCU",
    memory_size="128KB",
    VDD=V3V3,
    GND=GND,
    NRST=NRST,
    # UCPD with dead-battery: DBCC pins shorted to CC pins per AN5225 §11.3.1.
    PA8=USB_C.CC1,  # UCPD1_CC1
    PA9=USB_C.CC1,  # UCPD1_DBCC1 — shorted to CC1
    PB15=USB_C.CC2,  # UCPD1_CC2
    PA10=USB_C.CC2,  # UCPD1_DBCC2 — shorted to CC2
    # USB FS
    PA11=USB_C.D.N,  # USB D-
    PA12=USB_C.D.P,  # USB D+
    # SWD (PA14 doubles as BOOT0)
    PA13=SWD.SWDIO,
    PA14=SWD.SWCLK,
    # USART5 — picked because PD2 (RX) is FT_c (5 V tolerant when VDD=0).
    # USART1 RX (PA10) was unavailable: PA9/PA10 are reserved for DBCC.
    PD2=UART.RX,  # USART5_RX (FT_c)
    PD3=UART.TX,  # USART5_TX
    # Modem GPIOs to header. CTS must be FT_c since the target may drive 5 V.
    PD0=MODEM_CTS,  # header pin 2 (FT_c)
    PD1=MODEM_DTR,  # header pin 6 (output)
    # LEDs / VCC switch control
    PA0=LED_TX,
    PA1=LED_RX,
    PA2=VCC_EN,
    PA3=VCC_FAULT,
)

# BOOT0 / SWCLK pull-down — keeps PA14 low at reset (boot from flash)
Resistor(name="R_BOOT0", value="10kohm", package="0402", P1=SWD.SWCLK, P2=GND)

# Buttons — RESET (NRST → GND) and BOOT0 (PA14 → V3V3)
Button(name="SW_RESET", P1=NRST, P2=GND)
Button(name="SW_BOOT0", P1=SWD.SWCLK, P2=V3V3)

TagConnect(
    name="J_SWD",
    VSENSE=V3V3,
    GND=GND,
    SWD=SWD,
    NRST=NRST,
    SWO=NotConnected(),  # Cortex-M0+ has no SWO
)

# Activity LEDs — driven by MCU GPIO (current-sourced)
led("TX", LED_TX, "yellow", "1kohm")
led("RX", LED_RX, "blue", "1kohm")

# Target header — 1×6 SMD right-angle (SparkFun FTDI Basic pinout)
# Pin 1: GND  | Pin 2: CTS  | Pin 3: VCC
# Pin 4: TXD  | Pin 5: RXD  | Pin 6: DTR
PinHeader(
    name="J_HDR",
    positions=6,
    P1=GND,
    P2=MODEM_CTS,
    P3=VCC_OUT,
    P4=UART.TX,
    P5=UART.RX,
    P6=MODEM_DTR,
)

Board(name="Feign", layout_path="layout", layers=2)
