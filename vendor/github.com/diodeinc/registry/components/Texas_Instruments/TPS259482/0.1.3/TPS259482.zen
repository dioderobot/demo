"""TPS259482 — TI 3.5-23V, 12.2mΩ, 8A bi-directional eFuse with reference circuit (12-ball PowerWCSP YWP).

Implements the TI typical application circuit (datasheet §8.3) around the
TPS259482x silicon family:

- Combined 3-resistor UVLO/OVLO divider — VIN → R_DIV_HIGH → EN/UVLO → R_DIV_MID → OVLO → R_DIV_LOW → GND
- Configurable overcurrent limit (1A-9A) via R_ILM (also provides analog current monitor)
- Output slew rate via C_DVDT (1 nF → ~4 ms rise at 20 V)
- Overcurrent transient blanking via C_ITIMER (configurable `blanking_time`; default 8 ms / 10 nF)
- Optional reverse current blocking control (RCBCTRL)
- Local HF bypass on IN and OUT (100 nF/0402/50 V each)

The reference assumes the consuming board provides rail bulk on VIN (typically
the upstream regulator's output cap) and load-side decoupling on VOUT (typically
the downstream regulator's input cap). For standalone use with long traces back
to a bulk source, add at least 1 µF / 2×VIN locally on each rail.

EN/UVLO safety constraint: V_EN(pin) = VIN × 1.2V / `uvlo_threshold` for any
divider topology. Datasheet §6.1 sets V_EN abs max = 6.5 V; §6.3 recommends
≤ 5 V. The 6 V default keeps V_EN ≤ 5 V at the datasheet 23 V operating max.
A `check()` enforces `V_EN ≤ 6.5V` at `VIN.voltage.max` — tighten or relax by
adjusting the upstream `Power(voltage=...)` declaration. Boards with upstream
OVP (e.g. a USB-C port-protection IC clamping VIN at 22 V) can drop
`uvlo_threshold` as low as 1.2V × 22V / 6.5V ≈ 4.06 V, passing 5 V USB-C VBUS
cleanly.

Silicon variant selected by `fault_response`:

    fault_response   Symbol        MPN
    --------------   -----------   ---------------
    AutoRetry        TPS259482A    TPS259482AYWPR
    LatchOff         TPS259482L    TPS259482LYWPR

Sibling silicon variants (active-low SPLYGD, FLT pin, fixed fast-trip) live
in their own packages — not in this one.

Datasheet: https://www.ti.com/lit/ds/symlink/tps25948.pdf
"""

load("@stdlib/units.zen", "Voltage", "Current", "Resistance", "Time")
load("@stdlib/utils.zen", "e24", "e96")

Resistor = Module("@stdlib/generics/Resistor.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")

FaultResponse = enum("AutoRetry", "LatchOff")
fault_response = config(FaultResponse, default="AutoRetry", help="AutoRetry or LatchOff after a latched fault.")
current_limit = config(Current, default="5A", help="Overcurrent protection threshold (1A-9A).")
uvlo_threshold = config(Voltage, default="6V", help="Undervoltage lockout threshold.")
ovlo_threshold = config(Voltage, default="22V", help="Overvoltage lockout threshold.")
blanking_time = config(Time, default="8ms", help="Overcurrent transient blanking interval.")

VIN = io(Power(voltage="3.5V to 23V"), help="3.5-23V supply (28V abs max).")
VOUT = io(Power, help="Protected output, equals VIN minus FET drop.")
GND = io(Ground, help="Device ground.")
EN = io(Net, optional=True, help="Pull low to force shutdown (overrides UVLO divider).")
SPLYGD = io(Net, optional=True, help="Active-high open-drain Supply Good. Needs external pull-up.")
RCBCTRL = io(Net, optional=True, help="RCB control input (5µA pull-up). Pull low for bi-directional.")
ILM_MON = io(Net, optional=True, help="Analog current monitor output (voltage across R_ILM).")

_symbol = "TPS259482A" if fault_response == FaultResponse("AutoRetry") else "TPS259482L"

# Reject settings that would overstress EN/UVLO past DS §6.1 abs max (6.5V) at
# the declared rail max. V_EN(pin) = VIN × 1.2V/uvlo_threshold.
_vin_max = Voltage(VIN.voltage.max)
_uvlo_floor = _vin_max * "1.2V" / "6.5V"
check(
    uvlo_threshold >= _uvlo_floor,
    f"uvlo_threshold={uvlo_threshold} < {_uvlo_floor} (V_EN at VIN={_vin_max} would exceed 6.5V abs max).",
)


def uvlo_ovlo_divider(v_uvlo, v_ovlo, r_low):
    """Sized so V_EN_th = V_OVLO_th = 1.2V (typ). Returns (R_HIGH, R_MID).

    Topology: VIN → R_HIGH → EN/UVLO → R_MID → OVLO → R_LOW → GND.
    """
    v_th = Voltage("1.2V")
    total = r_low * (v_ovlo / v_th)
    r_mid = total * (v_th / v_uvlo) - r_low
    r_high = total - total * (v_th / v_uvlo)
    return e96(r_high), e96(r_mid)


def r_ilm(i_lim):
    """§7.3.3.2 Eq 5: R_ILM(Ω) = 4834 / I_LIM(A)."""
    return e96(Resistance("4834ohm") * Current("1A") / i_lim)


def c_itimer(t_blank):
    """§7.3.3.2 Eq 6: C_ITIMER = t × I_ITIMER(1.9µA) / ΔV_ITIMER(1.51V)."""
    return e24(Current("1.9uA") * t_blank / Voltage("1.51V"))


_OVLO = Net("OVLO")
_DVDT = Net("DVDT")
_ITIMER = Net("ITIMER")

Component(
    name="U1",
    symbol=Symbol(library="TPS259482.kicad_sym", name=_symbol),
    pins={
        "IN": VIN,
        "OUT": VOUT,
        "GND": GND,
        "EN/UVLO": EN,
        "OVLO": _OVLO,
        "SPLYGD": SPLYGD,
        "RCBCTRL": RCBCTRL,
        "DVDT": _DVDT,
        "ILM": ILM_MON,
        "ITIMER": _ITIMER,
    },
    spice_model=SpiceModel(
        "TPS259482_BEHAV.lib",
        "TPS259482_BEHAV",
        nets=[VIN, VOUT, GND, EN, _OVLO, RCBCTRL, SPLYGD, _DVDT, ILM_MON, _ITIMER],
        args={},
    ),
)

# Combined UVLO/OVLO divider (§7.3.1, §7.3.2). R_LOW = 27kΩ chosen for low Iq.
_DIV_R_LOW = Resistance("27kohm")
_DIV_R_HIGH, _DIV_R_MID = uvlo_ovlo_divider(uvlo_threshold, ovlo_threshold, _DIV_R_LOW)
Resistor(name="R_DIV_HIGH", value=_DIV_R_HIGH, package="0402", P1=VIN, P2=EN)
Resistor(name="R_DIV_MID", value=_DIV_R_MID, package="0402", P1=EN, P2=_OVLO)
Resistor(name="R_DIV_LOW", value=e96(_DIV_R_LOW), package="0402", P1=_OVLO, P2=GND)

# R_ILM is mandatory — sets I_LIM and provides the analog current monitor.
Resistor(name="R_ILM", value=r_ilm(current_limit), package="0402", P1=ILM_MON, P2=GND)

# C_DVDT (§7.3.3.1 Eq 4): 1 nF → ~4 ms rise at 20 V — limits inrush for ~10–100 µF downstream.
# Datasheet §6.3 requires VIN+5V cap rating; 50V covers VIN ≤ 45V.
Capacitor(name="C_DVDT", value="1nF", package="0402", voltage="50V", P1=_DVDT, P2=GND)
# C_ITIMER — default 8 ms → 10 nF (house match). Override `blanking_time` may not be sourceable.
Capacitor(name="C_ITIMER", value=c_itimer(blanking_time), package="0402", P1=_ITIMER, P2=GND)

# Local HF bypass only — see docstring on system-bulk assumption.
Capacitor(name="C_IN", value="100nF", package="0402", voltage="50V", P1=VIN, P2=GND)
Capacitor(name="C_OUT", value="100nF", package="0402", voltage="50V", P1=VOUT, P2=GND)

Layout(name="TPS259482", path="layout/TPS259482")

