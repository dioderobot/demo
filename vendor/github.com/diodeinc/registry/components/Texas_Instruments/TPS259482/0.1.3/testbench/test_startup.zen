"""TPS259482 OVLO/UVLO protection simulation.

Steps VIN through normal → overvoltage → normal → undervoltage to
exercise OVLO cutoff and UVLO shutdown behavior. Driven end-to-end by
`sim_analyze.py` — a marimo notebook that runs `pcb sim --netlist`,
executes ngspice in a tempdir, asserts behavior, and renders the plot.
No persistent output is written to disk.

    uvx marimo edit --sandbox sim_analyze.py    # interactive editor
    uvx marimo run  --sandbox sim_analyze.py    # read-only reactive app
    uv  run                  sim_analyze.py    # headless / CI

Uses the simplified behavioral model in ../TPS259482_BEHAV.lib (not
TI-provided).
"""

load("@stdlib/properties.zen", "Simulation")

TPS259482 = Module("../TPS259482.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")

VIN = Power(voltage="12V")
VOUT = Power()
GND = Ground()
EN = Net()
SPLYGD = Net()
RCBCTRL = Net()
ILM_MON = Net()

TPS259482(
    name="EFUSE",
    VIN=VIN,
    VOUT=VOUT,
    GND=GND,
    EN=EN,
    SPLYGD=SPLYGD,
    RCBCTRL=RCBCTRL,
    ILM_MON=ILM_MON,
    current_limit="5A",
    uvlo_threshold="6V",
    ovlo_threshold="22V",
    blanking_time="8ms",
)

# 4Ω load → 3A at 12V (below 5A current limit).
# suppress: bom.match_generic
Resistor(name="R_LOAD", value="4ohm", package="0603", P1=VOUT, P2=GND)

# SPLYGD pull-up to a 3.3V rail driven from the testbench setup.
Resistor(name="R_SPLYGD", value="10kohm", package="0402", P1=SPLYGD, P2=Net("V33"))

Simulation(
    name="SIM",
    setup="""
* TPS259482 OVLO/UVLO protection test
* VIN steps: 12V (normal) → 24V (above 22V OVLO) → 12V (normal) → 4V (below ~6V UVLO).
* Hold each plateau 5ms with 100µs transitions.

V_IN VIN GND PWL(0 12 5m 12 5.1m 24 10m 24 10.1m 12 15m 12 15.1m 4 20m 4)
V_33 V33 GND DC 3.3
V_RCB RCBCTRL GND DC 3.3

.control
  tran 5u 20m

  set wr_singlescale
  set wr_vecnames
  wrdata output/startup.csv v(VIN) v(VOUT) v(EN) v(EFUSE.OVLO) v(SPLYGD)
.endc

""",
)
