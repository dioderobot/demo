"""CSDxxxxxF3 — TI FemtoFET PICOSTAR YJM (0.73x0.64mm, 0.36mm)

Ultra-small N-channel and P-channel MOSFETs in the PICOSTAR YJM package.
Select by channel type and voltage rating. Pin 1 = Gate, Pin 2 = Source,
Pin 3 = Drain.

 MPN          | Ch | Vds  | Rds(on) @4.5V
 CSD13380F3   | N  | 12V  | 76mΩ
 CSD15380F3   | N  | 20V  | 1460mΩ
 CSD23280F3   | P  | 12V  | 116mΩ
 CSD25480F3   | P  | 20V  | 159mΩ
"""

load("@stdlib/units.zen", "Resistance")

Channel = enum("N", "P")
Vds = enum("12V", "20V")

channel = config(Channel, default="N", help="MOSFET channel type")
vds = config(Vds, default="12V", help="Drain-to-source voltage rating")

Pins = struct(D=io("D", Net), G=io("G", Net), S=io("S", Net))

_FAMILY = {
    ("N", "12V"): [("CSD13380F3", Resistance("76mOhm"))],
    ("N", "20V"): [("CSD15380F3", Resistance("1460mOhm"))],
    ("P", "12V"): [("CSD23280F3", Resistance("116mOhm"))],
    ("P", "20V"): [("CSD25480F3", Resistance("159mOhm"))],
}


def _select(ch, v):
    key = (ch.value, v.value)
    candidates = _FAMILY[key]
    primary_mpn = candidates[0][0]
    alts = [Part(mpn=a, manufacturer="Texas Instruments") for a, _ in candidates[1:]]
    return primary_mpn, alts


_mpn, _alts = _select(channel, vds)

Component(
    name="CSDxxxxxF3",
    symbol=Symbol(library="CSDxxxxxF3.kicad_sym", name=_mpn),
    pins={"D": Pins.D, "G": Pins.G, "S": Pins.S},
    properties={
        "alternatives": _alts,
    },
)
