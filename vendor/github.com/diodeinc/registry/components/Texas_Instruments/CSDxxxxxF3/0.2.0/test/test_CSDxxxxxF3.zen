"""Test: instantiate every CSDxxxxxF3 channel/vds combination."""

CSDxxxxxF3 = Module("../CSDxxxxxF3.zen")

_combos = [
    ("N", "12V"),
    ("N", "20V"),
    ("P", "12V"),
    ("P", "20V"),
]

for i, (ch, v) in enumerate(_combos):
    _name = "Q{}_{}_{}".format(i, ch, v)
    CSDxxxxxF3(
        name=_name,
        channel=ch,
        vds=v,
        D=Net("{}_D".format(_name)),
        G=Net("{}_G".format(_name)),
        S=Net("{}_S".format(_name)),
    )
