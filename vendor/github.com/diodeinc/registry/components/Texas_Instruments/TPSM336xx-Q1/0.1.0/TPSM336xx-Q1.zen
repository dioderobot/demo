# pcb:sch C_OUT1.C x=-72.1200 y=-115.3000 rot=0
# pcb:sch C_OUT2.C x=-21.3200 y=-115.3000 rot=0
# pcb:sch C_VCC.C x=-630.9200 y=11.7000 rot=0
