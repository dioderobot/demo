"""
LDFPVR Reference Design — ST LDF 1A Very Low Dropout Voltage Regulator

Type: LDO Regulator
Description: 1A, 2.6-16V input, adjustable 0.8-12V output, very low dropout, Power Good, DFN6-2x2
Features:
- Input Voltage Range: 2.6V to 16V
- Output Current: 1A continuous
- Adjustable Output: 0.8V to 12V via external resistor divider
- Low Dropout: 200mV typ @ 1A (500mV max)
- Low Quiescent Current: 200µA typ
- Enable pin with logic-level control
- Open-drain Power Good output
- DFN6-2x2 package
"""

load("@stdlib/interfaces.zen", "Ground", "Power")
load("@stdlib/checks.zen", "voltage_within")
load("@stdlib/units.zen", "Voltage", "Resistance")
load("@stdlib/utils.zen", "e96")
load("@stdlib/properties.zen", "Layout")

Capacitor = Module("@stdlib/generics/Capacitor.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")
LDFPVR_IC = Module("github.com/diodeinc/registry/components/LDFPVR/LDFPVR.zen")

# ---------------------------------------------------------------------------
# Design equations
# ---------------------------------------------------------------------------


def feedback_resistors(vout):
    """Compute ADJ feedback divider for a target output voltage.

    Datasheet §5.2:
        VOUT = VADJ × (1 + R1/R2), where VADJ = 0.8V (typ)

    Fix R2 = 20kohm (datasheet recommends 10k-100k range), solve for R1.
    Returns (r_top, r_bottom) rounded to E96.
    """
    v_adj = Voltage("0.8V")
    r_bottom = Resistance("20kohm")
    r_top = e96(r_bottom * (vout / v_adj - 1))
    return r_top, r_bottom


# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------


voltage_out = config(
    Voltage,
    default=Voltage("3.3V"),
    checks=voltage_within("0.8V – 12V"),
    help="Desired output voltage (0.8V to 12V). Feedback resistors are computed automatically.",
)

# ---------------------------------------------------------------------------
# IO ports
# ---------------------------------------------------------------------------

VIN = io(
    Power(voltage=Voltage("2.6V to 16V")),
    help="Input supply, 2.6V to 16V",
)
GND = io(Ground())
VOUT = io(
    Power(voltage=voltage_out),
    help="Regulated output, 1A max continuous",
)
EN = io(
    Net(VIN),
    optional=True,
    help="Active-high enable; default pulls up to VIN via 100k resistor (always-on)",
)
PG = io(
    Net(),
    optional=True,
    help="Open-drain power-good output; optional, no pull-up needed if unused",
)

_EN = Net()

# ---------------------------------------------------------------------------
# Computed values
# ---------------------------------------------------------------------------

_R_FB_TOP, _R_FB_BOTTOM = feedback_resistors(voltage_out)

# ---------------------------------------------------------------------------
# Internal nets
# ---------------------------------------------------------------------------

ADJ_NET = Net("ADJ")

# ---------------------------------------------------------------------------
# IC
# ---------------------------------------------------------------------------

LDFPVR_IC(
    name="U1",
    ADJ=ADJ_NET,
    EN=_EN,
    GND=GND,
    PG=PG,
    VIN=VIN,
    VOUT=VOUT,
)

# ---------------------------------------------------------------------------
# Feedback resistor divider (sets output voltage via ADJ pin)
# Datasheet §5.2: VOUT = 0.8V × (1 + R_FB_TOP / R_FB_BOTTOM)
# ---------------------------------------------------------------------------

Resistor(name="R_FB_TOP", value=_R_FB_TOP, package="0402", P1=VOUT, P2=ADJ_NET)
Resistor(name="R_FB_BOTTOM", value=_R_FB_BOTTOM, package="0402", P1=ADJ_NET, P2=GND)

# ---------------------------------------------------------------------------
# Enable pin pull-up to VIN (always-on default)
# Datasheet §5.3: EN must not float; tie to VIN when not controlled externally.
# 100kohm limits current per datasheet (IEN = 5-10µA max at VEN = VIN).
# ---------------------------------------------------------------------------

Resistor(name="R_EN", value="100kohm", package="0402", P1=EN, P2=_EN)

# ---------------------------------------------------------------------------
# Input capacitor — datasheet §5.1.1: minimum 1µF, place close to VIN pin
# ---------------------------------------------------------------------------

Capacitor(name="C_IN", value="10uF", package="0805", P1=VIN, P2=GND)

# ---------------------------------------------------------------------------
# Output capacitor — datasheet §5.1.2: minimum 2.2µF for stability
# ---------------------------------------------------------------------------

Capacitor(name="C_OUT", value="10uF", package="0805", P1=VOUT, P2=GND)

Layout(
    name="LDFPVR",
    path="layout/LDFPVR",
)

