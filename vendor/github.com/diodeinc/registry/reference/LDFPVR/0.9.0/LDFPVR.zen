# pcb:sch R_EN.R x=-138.1600 y=-255.0000 rot=0
# pcb:sch R_FB_BOTTOM.R x=446.0400 y=-140.7000 rot=0
# pcb:sch R_FB_TOP.R x=446.0400 y=-255.0000 rot=0
