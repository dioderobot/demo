"""TPS745x Reference Design

1.5-V to 6-V, 500-mA, low-IQ, high-PSRR LDO with power good (automotive).
Implements the TPS745-Q1 adjustable-output typical application circuit with:
- Configurable output voltage via feedback resistor divider (0.55 V to 5.5 V)
- Input and output ceramic decoupling
- Optional feed-forward capacitor for improved transient response
- Push-pull power-good output
"""

load("@stdlib/interfaces.zen", "Gpio")
load("@stdlib/checks.zen", "voltage_within")
load(
    "@stdlib/units.zen",
    "Capacitance",
    "Resistance",
    "Voltage",
)
load("@stdlib/utils.zen", "e96")

TPS74501PCQWDRVRQ1 = Module(
    "github.com/diodeinc/registry/components/Texas_Instruments/TPS74501PCQWDRVRQ1/TPS74501PCQWDRVRQ1.zen"
)
Resistor = Module("@stdlib/generics/Resistor.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")

# --- Configs ---

voltage_out = config(
    Voltage,
    default="1.8V",
    checks=voltage_within("0.55V to 5.5V"),
    help="Regulated output voltage (0.55 V to 5.5 V).",
)

enable_cff = config(
    bool,
    default=False,
    help="Enable feed-forward capacitor?",
)

# --- IOs ---

VIN = io(Power(voltage="1.5V to 6V"))
VOUT = io(Power(voltage=voltage_out), help="Regulated output supply")
GND = io(Ground())
EN = io(Net(VIN), optional=True, help="Enable input. Defaults to VIN (always on).")
PG = io(Gpio(), optional=True, help="Power-good push-pull output (active high).")

# --- Internal nets ---

_FB = Net()

# --- Feedback divider ---
# Datasheet Eq 2: V_OUT = V_FB * (1 + R1/R2), where V_FB = 0.55 V

_V_FB = Voltage("0.55V")


def feedback_divider(v_out):
    """Compute feedback resistor divider for target output voltage.
    R1+R2 must stay below V_OUT/(I_FB*100) per datasheet Eq 3.
    I_FB = 0.1uA max, so for 1.8V: R1+R2 <= 180kohm.
    """
    r2 = Resistance("51kohm")
    r1 = e96(r2 * (v_out / _V_FB - 1))
    return r1, r2


_r_fb_top, _r_fb_bot = feedback_divider(voltage_out)

# --- Main IC ---

TPS74501PCQWDRVRQ1(
    name="U1",
    IN=VIN,
    OUT=VOUT,
    GND=GND,
    EP=GND,
    EN=EN,
    FB=_FB,
    PG=PG,
)

# --- Feedback resistor divider (from VOUT to GND) ---

Resistor(
    name="R_FB_TOP",
    value=_r_fb_top,
    package="0402",
    P1=VOUT,
    P2=_FB,
)

Resistor(
    name="R_FB_BOT",
    value=_r_fb_bot,
    package="0402",
    P1=_FB,
    P2=GND,
)

# --- Feed-forward capacitor ---
# Datasheet recommends 10 nF minimum on FB pin for improved transient response

Capacitor(
    name="C_FF",
    value="10nF",
    package="0402",
    dnp=not enable_cff,
    P1=_FB,
    P2=VOUT,
)

# --- Input decoupling ---
# Datasheet: >= 1 uF ceramic, X5R/X7R

Capacitor(
    name="C_IN",
    value="2.2uF",
    voltage="10V",
    package="0402",
    mpn="GRM155Z71A225KE44D",
    manufacturer="Murata Electronics",
    P1=VIN,
    P2=GND,
)

# --- Output decoupling ---
# Datasheet: >= 1 uF ceramic, X5R/X7R, max 220 uF

Capacitor(
    name="C_OUT",
    value="2.2uF",
    voltage="10V",
    package="0402",
    mpn="GRM155Z71A225KE44D",
    manufacturer="Murata Electronics",
    P1=VOUT,
    P2=GND,
)

Layout(
    name="TPS745x",
    path="layout/TPS745x",
)

