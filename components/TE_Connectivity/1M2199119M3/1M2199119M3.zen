"""1-2199119-3 Component"""

# Pins - Using exact KiCad symbol pin names
Pins = struct(
    # Control signals
    PERST=io("PERST", Net),
    CLKREQ=io("CLKREQ", Net),
    PEWAKE=io("PEWAKE", Net),
    DEVSLP=io("DEVSLP", Net),
    # PCIe differential pairs
    PETp0_SATA_Aplus=io("PETp0_SATA_Aplus", Net),
    PETn0_SATA_Aminus=io("PETn0_SATA_Aminus", Net),
    PERp0_SATA_Bminus=io("PERp0_SATA_Bminus", Net),
    PERn0_SATA_Bplus=io("PERn0_SATA_Bplus", Net),
    PETp1=io("PETp1", Net),
    PETn1=io("PETn1", Net),
    PERp1=io("PERp1", Net),
    PERn1=io("PERn1", Net),
    PETp2=io("PETp2", Net),
    PETn2=io("PETn2", Net),
    PERp2=io("PERp2", Net),
    PERn2=io("PERn2", Net),
    PETp3=io("PETp3", Net),
    PETn3=io("PETn3", Net),
    PERp3=io("PERp3", Net),
    PERn3=io("PERn3", Net),
    # Reference Clock
    REFCLKp=io("REFCLKp", Net),
    REFCLKn=io("REFCLKn", Net),
    # Power
    VDD=io("VDD", Net),
    GND=io("GND", Net),
    # Other signals
    DAS_DSS_LED1=io("DAS_DSS_LED1", Net),
    PEDET=io("PEDET", Net),
    SUSCLK=io("SUSCLK", Net),
    # Not connected
    NC=io("NC", Net),
)

# Component
Component(
    name="1-2199119-3",
    symbol=Symbol(library="@kicad-symbols/Connector.kicad_sym", name="Bus_M.2_Socket_M"),
    footprint=File("121991193.kicad_mod"),
    pins={
        # Power and Ground pins (symbol expects multiple instances)
        "3.3V": Pins.VDD,
        "GND": Pins.GND,
        # PCIe differential pairs
        "PETp0/SATA-A+": Pins.PETp0_SATA_Aplus,
        "PETn0/SATA-A-": Pins.PETn0_SATA_Aminus,
        "PERp0/SATA-B-": Pins.PERp0_SATA_Bminus,
        "PERn0/SATA-B+": Pins.PERn0_SATA_Bplus,
        "PETp1": Pins.PETp1,
        "PETn1": Pins.PETn1,
        "PERp1": Pins.PERp1,
        "PERn1": Pins.PERn1,
        "PETp2": Pins.PETp2,
        "PETn2": Pins.PETn2,
        "PERp2": Pins.PERp2,
        "PERn2": Pins.PERn2,
        "PETp3": Pins.PETp3,
        "PETn3": Pins.PETn3,
        "PERp3": Pins.PERp3,
        "PERn3": Pins.PERn3,
        # Reference Clock
        "REFCLKp": Pins.REFCLKp,
        "REFCLKn": Pins.REFCLKn,
        # Control signals
        "~{PERST}": Pins.PERST,
        "~{CLKREQ}": Pins.CLKREQ,
        "~{PEWAKE}": Pins.PEWAKE,
        "DEVSLP": Pins.DEVSLP,
        "DAS/~{DSS}/~{LED1}": Pins.DAS_DSS_LED1,
        "PEDET": Pins.PEDET,
        "SUSCLK": Pins.SUSCLK,
        # NC pins (not connected)
        "NC": Pins.NC,
    },
    properties={
        "value": "1-2199119-3",
        "mpn": "1-2199119-3",
        "manufacturer": "TE Connectivity",
        "description": "PCIe Gen3 x4 M.2 Socket",
        "package": "M.2_Socket_M",
        "alternatives": [
            {"mpn": "MDT320M01004", "manufacturer": "Amphenol ICC (FCI)"},
            {"mpn": "91302-32-067RDM", "manufacturer": "UMAX"},
        ],
        "LCSC Part": "C1509730",
    },
)

add_property("layout_path", "build/preview")

