"""PUSB3F96X Component"""

# Pins
Pins = struct(
    CH1 = io("CH1", Net),
    CH2 = io("CH2", Net),
    CH3 = io("CH3", Net),
    CH4 = io("CH4", Net),
    GND = io("GND", Net),
)

# Component
Component(
    name = "PUSB3F96X",
    symbol = Symbol(library = "PUSB3F96X.kicad_sym"),
    footprint = File("PUSB3F96X.kicad_mod"),
    pins = {
        "CH1": Pins.CH1,
        "CH2": Pins.CH2,
        "CH3": Pins.CH3,
        "CH4": Pins.CH4,
        "GND_1": Pins.GND,
        "GND_2": Pins.GND,
        "N.C._1": Pins.CH4,
        "N.C._2": Pins.CH3,
        "N.C._3": Pins.CH2,
        "N.C._4": Pins.CH1,
    },
    properties = {
        "value": "PUSB3F96X",
        "mpn": "PUSB3F96X",
    },
)

add_property("layout_path", "build/preview")
