"""B3U-1000P Component"""

# Pins
Pins = struct(
    A=io("A", Net),
    K=io("K", Net),
)

# Component
Component(
    name="B3U-1000P",
    symbol=Symbol(library="B3U-1000P.kicad_sym"),
    footprint=File("B3U-1000P.kicad_mod"),
    pins={
        "A": Pins.A,
        "K": Pins.K,
    },
    properties={
        "value": "B3U-1000P",
        "mpn": "B3U-1000P",
    },
)

add_property("layout_path", "build/preview")
