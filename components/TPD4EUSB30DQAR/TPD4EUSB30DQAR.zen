"""TPD4EUSB30DQAR Component"""

# Pins
Pins = struct(
    D1M = io("D1M", Net),
    D1P = io("D1P", Net),
    D2M = io("D2M", Net),
    D2P = io("D2P", Net),
    GND = io("GND", Net),
)

# Component
Component(
    name = "TPD4EUSB30DQAR",
    symbol = Symbol(library = "TPD4EUSB30DQAR.kicad_sym"),
