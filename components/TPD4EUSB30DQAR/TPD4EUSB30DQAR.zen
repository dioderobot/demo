    pins = {
        "D1-": Pins.D1M,
        "D1+": Pins.D1P,
        "D2-": Pins.D2M,
        "D2+": Pins.D2P,
        "GND_1": Pins.GND,
        "GND_2": Pins.GND,
        "N.C._1": Pins.D2M,
        "N.C._2": Pins.D2P,
        "N.C._3": Pins.D1M,
        "N.C._4": Pins.D1P,
    },
    properties = {
        "value": "TPD4EUSB30DQAR",
        "mpn": "TPD4EUSB30DQAR",
        "description": "Texas Instruments - TPD4EUSB30DQAR - ESD and Surge Protection",
        "manufacturer": "Texas Instruments",
        "LCSC Part" : "C90627",
