load("@stdlib/interfaces.zen", "I2c", "Uart", "Usart", "Can", "Power", "Ground", "Gpio", "Analog", "Swd", "Usb2", "Pwm")

# -----------------------------------------------------------------------------
# PAB X1 – 100-pin "power & low-speed" connector
# (Hirose DF40C-100, 0.4 mm pitch, 3 mm stack; FMU = receptacle, PAB = plug)
#
# Pin | Signal (FMU-v6X)            | STM32H753 pin / AF | Description
# ----|-----------------------------|--------------------|-----------------------------
# 1   | FMU_CH8                     | PH9  / TIM12_CH2   | AUX PWM 8
# 2   | GND                         | —                  |
# 3   | FMU_CH7                     | PH6  / TIM12_CH1   | AUX PWM 7
# 4   | BUZZER_1                    | PF9  / TIM14_CH1   |
# 5   | FMU_CH6                     | PD14 / TIM4_CH3    | AUX PWM 6
# 6   | GND                         | —                  |
# 7   | FMU_CH5                     | PD13 / TIM4_CH2    | AUX PWM 5
# 8   | I2C3_SDA_BASE_MS5611_EXT1   | PH8  / I²C3_SDA    |
# 9   | GND                         | —                  |
# 10  | I2C3_SCL_BASE_MS5611_EXT1   | PH7  / I²C3_SCL    |
# 11  | FMU_CH4                     | PH10 / TIM5_CH1    | AUX PWM 4
# 12  | I2C2_SDA_BASE_GPS2          | PF0  / I²C2_SDA    |
# 13  | FMU_CH3                     | PH11 / TIM5_CH2    | AUX PWM 3
# 14  | I2C2_SCL_BASE_GPS2          | PF1  / I²C2_SCL    |
# 15  | FMU_CH2                     | PH12 / TIM5_CH3    | AUX PWM 2
# 16  | I2C1_SDA_BASE_GPS1          | PB7  / I²C1_SDA    |
# 17  | FMU_CH1                     | PI0  / TIM5_CH4    | AUX PWM 1
# 18  | I2C1_SCL_BASE_GPS1          | PB8  / I²C1_SCL    |
# 19-20| GND                         | —                  |
# 21  | FMU_SAFETY_SWITCH_IN        | PF5                |
# 22  | UART7_RTS_TELEM1            | PF8  / UART7_RTS   |
# 23  | FMU_nSAFETY_SWITCH_LED_OUT  | PD10               |
# 24  | UART7_CTS_TELEM1            | PE10 / UART7_CTS   |
# 25  | HW_VER_REV_DRIVE            | PG0                |
# 26  | HW_REV_SENSE               | PH4  / ADC3_IN15   |
# 27  | HW_VER_SENSE               | PH3  / ADC3_IN14   |
# 28  | UART8_TX_GPS2               | PE1  / UART8_TX    |
# 29  | V_RTC_BAT                   | —                  | RTC battery input
# 30  | UART8_RX_GPS2               | PE0  / UART8_RX    |
# 31-32| GND                         | —                  |
# 33  | VDD_3V3_SPEKTRUM_EN         | PH2                |
# 34  | USART1_RX_GPS1              | PB7  / USART1_RX   |
# 35  | VDD_5V_PERIPH_nEN           | PG4                |
# 36  | USART1_TX_GPS1              | PB6  / USART1_TX   |
# 37  | VDD_5V_PERIPH_nOC           | PE15               |
# 38  | GND                         | —                  |
# 39  | FMU_PPM_INPUT               | PI5  / TIM8_CH1_IN |
# 40  | USART2_TX_TELEM3            | PD5  / USART2_TX   |
# 41  | GND                         | —                  |
# 42  | USART2_RX_TELEM3            | PA3  / USART2_RX   |
# 43-46| GND / USART2_RTS/CTS_TELEM3 | PD4 / PD3          |
# 47  | GND                         | —                  |
# 48  | USART2_CTS_TELEM3           | PD3  / USART2_CTS  |
# 49  | VDD_5V_IN A                 | — (rail)           |
# 50  | GND                         | —                  |
# 51  | VDD_5V_IN B                 | —                  |
# 52  | UART5_TX_TELEM2             | PC12 / UART5_TX   |
# 53  | VDD_5V_IN C                 | —                  |
# 54  | UART5_RX_TELEM2             | PD2  / UART5_RX    |
# 55  | VDD_5V_IN (mirror)          | —                  |
# 56  | GND                         | —                  |
# 57  | CAN2_TX                     | PB6  / FDCAN2_TX   |
# 58  | UART5_RTS_TELEM2            | PC8  / UART5_RTS   |
# 59  | CAN2_RX                     | PB12 / FDCAN2_RX   |
# 60  | UART5_CTS_TELEM2            | PC9  / UART5_CTS   |
# 61-62| GND                         | —                  |
# 63  | CAN1_TX                     | PB13 / FDCAN1_TX   |
# 64  | UART7_TX_TELEM1             | PE8  / UART7_TX    |
# 65  | CAN1_RX                     | PB8  / FDCAN1_RX   |
# 66  | UART7_RX_TELEM1             | PF6  / UART7_RX    |
# 67-68| GND                         | —                  |
# 69  | USART3_TX_DEBUG             | PD8  / USART3_TX   |
# 70  | USART6_RX_FROM_IO           | PC7  / USART6_RX   |
# 71  | USART3_RX_DEBUG             | PD9  / USART3_RX   |
# 72  | USART6_TX_TO_IO             | PC6  / USART6_TX   |
# 73-74| GND                         | —                  |
# 75  | FMU_SWDIO                   | PA13 / SWDIO       |
# 76  | USB_D_P                     | PA12 / USB_FS_DP   |
# 77  | FMU_SWCLK                   | PA14 / SWCLK       |
# 78  | USB_D_N                     | PA11 / USB_FS_DN   |
# 79  | GND                         | —                  |
# 80  | VBUS_SENSE                  | PA9  / ADC12_IN18  |
# 81  | VDD_5V_HIPOWER_nEN          | PG10               |
# 82  | GND                         | —                  |
# 83  | VDD_5V_HIPOWER_nOC          | PF13               |
# 84/86| FMU_VDD_3V3                 | — (rail out)       |
# 85  | nARMED                      | PE6                |
# 87  | FMU_nRST                    | NRST               |
# 88  | GND                         | —                  |
# 89  | nPOWER_IN_A                 | PG1                |
# 90  | ADC1_6V6                    | PB1  / ADC1_IN9    |
# 91  | nPOWER_IN_B                 | PG2                |
# 92  | ADC1_3V3                    | PC3  / ADC1_IN13   |
# 93  | nPOWER_IN_C                 | PG3                |
# 94-100| GND / CAP / UART4 / FMU_CAP1 | …                 |
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# IO ports
# -----------------------------------------------------------------------------

# PWM outputs (AUX channels)
fmu_ch1 = io("fmu_ch1", Pwm)
fmu_ch2 = io("fmu_ch2", Pwm)
fmu_ch3 = io("fmu_ch3", Pwm)
fmu_ch4 = io("fmu_ch4", Pwm)
fmu_ch5 = io("fmu_ch5", Pwm)
fmu_ch6 = io("fmu_ch6", Pwm)
fmu_ch7 = io("fmu_ch7", Pwm)
fmu_ch8 = io("fmu_ch8", Pwm)

# I2C buses
i2c1 = io("i2c1", I2c)
i2c2 = io("i2c2", I2c)
i2c3 = io("i2c3", I2c)

# UART/USART buses
usart1 = io("usart1", Usart)  # GPS1 (2-wire)
usart2 = io("usart2", Usart)  # TELEM3 (RTS/CTS)
usart3 = io("usart3", Usart)  # DEBUG (2-wire)
usart5 = io("usart5", Usart)  # TELEM2 (RTS/CTS)
usart6 = io("usart6", Usart)  # PX4IO (2-wire)
usart7 = io("usart7", Usart)  # TELEM1 (RTS/CTS)

uart4 = io("uart4", Uart)
uart8 = io("uart8", Uart)  # GPS2 (no flow control)

# CAN buses
can1 = io("can1", Can)
can2 = io("can2", Can)

# Power rails
vdd_3v3 = io("vdd_3v3", Power)
vdd_5v_in = io("vdd_5v_in", Power)
gnd = io("gnd", Ground)

# Control/status signals
buzzer = io("buzzer", Gpio)
safety_switch_in = io("safety_switch_in", Gpio)
hw_rev_sense = io("hw_rev_sense", Analog)
safety_switch_led = io("safety_switch_led", Gpio)
hw_ver_drive = io("hw_ver_drive", Gpio)
hw_ver_sense = io("hw_ver_sense", Analog)
ppm_input = io("ppm_input", Gpio)
armed = io("armed", Gpio)
reset = io("reset", Gpio)

# Power control
spektrum_en = io("spektrum_en", Gpio)
periph_5v_en = io("periph_5v_en", Gpio)
periph_5v_oc = io("periph_5v_oc", Gpio)
hipower_5v_en = io("hipower_5v_en", Gpio)
hipower_5v_oc = io("hipower_5v_oc", Gpio)
power_in_a = io("power_in_a", Gpio)
power_in_b = io("power_in_b", Gpio)
power_in_c = io("power_in_c", Gpio)

# ADC inputs
adc_6v6 = io("adc_6v6", Analog)
adc_3v3 = io("adc_3v3", Analog)

# Debug interface
swd = io("swd", Swd)

# USB interface
usb = io("usb", Usb2)
vbus_sense = io("vbus_sense", Analog)

# RTC battery
rtc_bat = io("rtc_bat", Power)

# -----------------------------------------------------------------------------
# Component definition
# -----------------------------------------------------------------------------

Component(
    name="X1",
    symbol=Symbol(
        library="@kicad-symbols/Connector_Generic_MountingPin.kicad_sym", name="Conn_02x50_Row_Letter_First_MountingPin"
