load("@stdlib/interfaces.zen", "I2c", "Power", "Ground", "Gpio")

Capacitor = Module("@stdlib/generics/Capacitor.zen")

# BMM150 Three-Axis Geomagnetic Sensor
# FlipCore, Hall Effect Sensor X, Y, Z Axis
# 12-WLCSP (1.56x1.56mm)
# Voltage - Supply: 1.62V ~ 3.6V (VDD), 1.2V ~ 3.6V (VDDIO)
# Interface: I2C
# Temperature: -40°C ~ 85°C

# I/O ports
VCC = io("VCC", Power)  # Power supply (1.62V-3.6V for both VDD and VDDIO)
GND = io("GND", Ground)  # Ground
I2C = io("I2C", I2c)  # I2C interface

# Interrupt pins
INT = io("INT", Gpio, optional=True, default=Gpio())  # Interrupt output pin
DRDY = io("DRDY", Gpio, optional=True, default=Gpio())  # Data ready output pin

# Main component
Component(
    name="U",
    symbol=Symbol(library="@kicad-symbols/Sensor_Magnetic.kicad_sym", name="BMM150"),
    footprint=File("@kicad-footprints/Package_CSP.pretty/WLCSP-12_1.56x1.56mm_P0.4mm.kicad_mod"),
    pins={
        "PS": VCC,  # Protocol Select - tie to VCC for I2C
        "SCK": I2C.SCL,  # I2C Clock
        "CSB": GND,  # Address select - tie to GND for 0x10
        "VDDIO": VCC,  # I/O supply
        "SDI": I2C.SDA,  # I2C Data
        "SDO": GND,  # Address select - tie to GND for 0x10
        "GND": GND,
        "INT": INT,  # Interrupt (or grounded if not used)
        "DRDY": DRDY,  # Data ready (or grounded if not used)
        "VDD": VCC,  # Main supply
    },
    mpn="BMM150",
    properties={
        "package": "12-WLCSP",
    },
)

# Power supply decoupling capacitors (recommended: 100nF per datasheet)
# VCC supply (both analog VDD and digital VDDIO, 3.3V typ)
# Separate caps for each power pin for better high-frequency decoupling
Capacitor(name="C1", value="100nF", package="0402", voltage="6.3V", dielectric="X7R", P1=VCC, P2=GND)
Capacitor(name="C2", value="100nF", package="0402", voltage="6.3V", dielectric="X7R", P1=VCC, P2=GND)
