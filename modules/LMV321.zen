# LMV321 Op Amp Module
#
# Wraps the LMV321IDBVR op amp with a 100nF bypass capacitor on the supply.
#
# Exposed pins:
#   IN_POS – non-inverting input (IN+)
#   IN_NEG – inverting input (IN-)
#   OUT    – output
#   VCC    – positive supply (2.7V to 5.5V)
#   GND    – ground

load("@stdlib/interfaces.zen", "Analog", "Ground", "Power")

LMV321_Component = Module("github.com/dioderobot/demo/components/Texas_Instruments/LMV321IDBVR/LMV321IDBVR.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")

# External interfaces
in_pos = io("IN_POS", Net)
in_neg = io("IN_NEG", Net)
output = io("OUT", Net)
vcc = io("VCC", Power)
gnd = io("GND", Ground)

# Op amp
LMV321_Component(
    name="U",
    **{
        "IN+": in_pos,
        "IN-": in_neg,
        "OUT": output,
        "V+": vcc,
        "GND": gnd,
    }
)

# Supply bypass capacitor (place close to VCC/GND pins)
Capacitor(name="C_BYPASS", package="0402", value="100nF", P1=vcc, P2=gnd)

# pcb:sch C_BYPASS.C x=-8.6200 y=-737.6000 rot=0
# pcb:sch GND.0 x=75.2000 y=-470.9000 rot=0
# pcb:sch GND.1 x=-1.0000 y=-648.7000 rot=0
# pcb:sch U.LMV321IDBVR x=-1.0000 y=-636.0000 rot=0
