load("@stdlib/interfaces.zen", "I2c", "Spi", "Power", "Ground", "Gpio")

Capacitor = Module("@stdlib/generics/Capacitor.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")

# ICM-45686 6-axis IMU (Accelerometer + Gyroscope) with dual interface support
# Package: 14-LGA (2.5x3mm)
# Interface: I2C/I3C/SPI host interface + auxiliary interface

# I2C address configuration - based on AP_ADO pin state
address = config("address", int, default=0x68)  # 0x68 (ADO=0) or 0x69 (ADO=1)

# Power
VCC = io("VCC", Power)  # Power supply (3.3V for both VDD and VDDIO)
GND = io("GND", Ground)  # Pin 6: Ground

# Main SPI interface
SPI = io("SPI", Spi)  # Pins 12,13,14,1: SPI interface

# Interrupts (optional)
INT1 = io("INT1", Gpio, optional=True)  # Pin 4: Interrupt 1
INT2 = io("INT2", Gpio, optional=True)  # Pin 9: Interrupt 2 / FSYNC / CLKIN

# Reserved pins (not connected in standard SPI mode)
RESV2 = io("RESV2", Gpio, optional=True)  # Pin 2: Reserved
RESV3 = io("RESV3", Gpio, optional=True)  # Pin 3: Reserved
RESV7 = io("RESV7", Gpio, optional=True)  # Pin 7: Reserved
RESV10 = io("RESV10", Gpio, optional=True)  # Pin 10: Reserved
RESV11 = io("RESV11", Gpio, optional=True)  # Pin 11: Reserved

Component(
    name="ICM45686",
    footprint=File("@kicad-footprints/Package_LGA.pretty/LGA-14_3x2.5mm_P0.5mm_LayoutBorder3x4y.kicad_mod"),
    pin_defs={
        "AP_SDO_ADO": "1",  # AP SPI data out / I2C address select
        "AUX1_SDIO": "2",  # AUX SPI data I/O / I2C master data / Reserved
        "AUX1_SCLK": "3",  # AUX SPI clock / I2C master clock / Reserved
        "INT1": "4",  # Interrupt 1
        "VDDIO": "5",  # I/O power supply
        "GND": "6",  # Ground
        "RESV7": "7",  # Reserved
        "VDD": "8",  # Core power supply
        "INT2": "9",  # Interrupt 2 / FSYNC / CLKIN
        "AUX1_CS": "10",  # AUX SPI chip select / Reserved
        "AUX1_SDO": "11",  # AUX SPI data out / Reserved
        "AP_CS": "12",  # AP SPI chip select
        "AP_SCL_SCLK": "13",  # AP I2C clock / SPI clock
        "AP_SDA_SDIO": "14",  # AP I2C data / SPI data I/O
    },
    pins={
        "AP_SDO_ADO": SPI.MISO,  # Pin 1: SPI data out
        "AUX1_SDIO": RESV2,  # Pin 2: Reserved
        "AUX1_SCLK": RESV3,  # Pin 3: Reserved
        "INT1": INT1,  # Pin 4: Interrupt 1
        "VDDIO": VCC,  # Pin 5: I/O power supply
        "GND": GND,  # Pin 6: Ground
        "RESV7": RESV7,  # Pin 7: Reserved
        "VDD": VCC,  # Pin 8: Core power supply
        "INT2": INT2,  # Pin 9: Interrupt 2
        "AUX1_CS": RESV10,  # Pin 10: Reserved
        "AUX1_SDO": RESV11,  # Pin 11: Reserved
        "AP_CS": SPI.CS,  # Pin 12: SPI chip select
        "AP_SCL_SCLK": SPI.CLK,  # Pin 13: SPI clock
        "AP_SDA_SDIO": SPI.MOSI,  # Pin 14: SPI data in
    },
    mpn="ICM-45686",
    properties={
        "package": "14-LGA",
    },
)

# Decoupling capacitor
Capacitor(name="C_VCC", value="100nF", package="0402", voltage="16V", dielectric="X7R", P1=VCC, P2=GND)

# Pull-down on AP_SDO_ADO for deterministic I2C address (0x68) if bus is reconfigured
Resistor(name="R_ADO_PD", value="10kOhm", package="0402", P1=SPI.MISO, P2=GND)
