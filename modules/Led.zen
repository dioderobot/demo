# LED + series resistor, 0402
#
# Exposed pins:
#   vcc – connect to power rail
#   gnd – connect to GND
#
# Parameters:
#   color – one of {"blue", "green", "orange", "red"}
#   supply_voltage – supply voltage (e.g., "3.3V")

load("@stdlib/interfaces.zen", "Power", "Ground")
load("@stdlib/units.zen", "unit", "Voltage")
Led      = Module("@stdlib/generics/Led.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")

# ------------------------------------------------------------
# User parameters
# ------------------------------------------------------------
color = config("color", str, default="red")
supply_voltage = config("supply_voltage", str, default="3.3V")

# Parse supply voltage
vsup_unit = unit(supply_voltage, Voltage)
vsup = vsup_unit.value  # voltage in volts

# ------------------------------------------------------------
# Static part database (0402 LEDs from Vishay + series R)
# Data from Digikey: Forward voltage and test current per datasheet
# ------------------------------------------------------------
parts = {
    "blue":   { "mpn": "VLMB1500-GS08", "vf": 2.8, "i_test": 0.005, "r": 110 },
    "green":  { "mpn": "VLMG1500-GS08", "vf": 2.0, "i_test": 0.020, "r": 150 },
    "orange": { "mpn": "VLMO1500-GS08", "vf": 2.0, "i_test": 0.020, "r": 261 },
    "red":    { "mpn": "VLMS1500-GS08", "vf": 2.0, "i_test": 0.020, "r": 150 },
}

clr = str(color).lower()
if clr not in parts:
    error("Unsupported LED color '%s'. Supported: %s" % (clr, list(parts.keys())))

data    = parts[clr]
vf      = data["vf"]            # forward voltage in volts
i_test  = data["i_test"]        # test current in amps
r_ohm   = data["r"]             # series resistor in ohms
i_led   = (vsup - vf) / r_ohm   # resulting current (A)

# ------------------------------------------------------------
# Safety checks
# ------------------------------------------------------------
check(vf < vsup, "Forward voltage (%s V) >= supply (%s V)" % (vf, vsup))
check(i_led >= 0, "Calculated LED current is negative")
check(i_led <= i_test, "LED current (%s mA) exceeds rated test current (%s mA)" % (i_led*1e3, i_test*1e3))

# ------------------------------------------------------------
# External interfaces
# ------------------------------------------------------------
p1 = io("p1", Net)  # Connect to VCC for open-drain or MCU pin for push-pull
p2 = io("p2", Net)  # Connect to MCU pin for open-drain or GND for push-pull

# Internal net between LED and resistor
led_r_net = Net("LED_R_NET")

# ------------------------------------------------------------
# Components
# ------------------------------------------------------------
Led(
    name            = "D",
    package         = "0402",
    color           = clr,
    mpn             = data["mpn"],
    forward_voltage = "%sV" % vf,
    forward_current = "%smA" % (i_led*1e3),
    A               = led_r_net,    # Anode to p1 (VCC for open-drain)
    K               = p2,           # Cathode to internal net
)

Resistor(
    name    = "R_D",
    package = "0402",
    value   = "%dOhm" % r_ohm,
    P1      = p1,          # From LED cathode
    P2      = led_r_net,   # To p2 (MCU pin for open-drain)
)
