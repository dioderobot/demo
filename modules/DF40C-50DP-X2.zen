load("@stdlib/interfaces.zen", "Spi", "Power", "Ground", "Gpio", "NotConnected", "Rmii")

# -----------------------------------------------------------------------------
# PAB X2 – 50-pin "high-speed / expansion" connector
# (Hirose DF40C-50, 0.4 mm pitch, 3 mm stack)
#
# Pin | Signal (FMU-v6X)       | STM32H753 pin / AF | Description
# ----|------------------------|--------------------|----------------------------
# 1   | GND                    | —                  |
# 2   | ETH_MDIO               | PA2  / ETH_MDIO    |
# 3   | ETH_REF_CLK            | PA1  / ETH_REF_CLK |
# 4   | ETH_MDC                | PC1  / ETH_MDC     |
# 5   | GND                    | —                  |
# 6   | ETH_POWER_EN           | PG15               | 3 V3 switch for PHY
# 7   | ETH_CRS_DV             | PA7  / ETH_CRS_DV  |
# 8   | GND                    | —                  |
# 9   | GND                    | —                  |
# 10  | SPARE01                | —                  |
# 11  | ETH_RXD0               | PC4  / ETH_RXD0    |
# 12  | SPARE02                | —                  |
# 13  | GND                    | —                  |
# 14  | SPARE03                | —                  |
# 15  | ETH_RXD1               | PC5  / ETH_RXD1    |
# 16  | SPARE04                | —                  |
# 17  | GND                    | —                  |
# 18  | SPARE05                | —                  |
# 19  | ETH_TXD0               | PG13 / ETH_TXD0    |
# 20  | SPARE06                | —                  |
# 21  | GND                    | —                  |
# 22  | SPARE07                | —                  |
# 23  | ETH_TXD1               | PG12 / ETH_TXD1    | *** NOTE: STM32 uses PG12 not PB13 ***
# 24  | SPARE08                | —                  |
# 25  | GND                    | —                  |
# 26  | SPARE09                | —                  |
# 27  | ETH_TX_EN              | PB11 / ETH_TX_EN   |
# 28  | SPARE10                | —                  |
# 29  | GND                    | —                  |
# 30  | SPARE11                | —                  |
# 31  | SPI6_MISO_EXTERNAL1    | PA6  / SPI6_MISO   | *** PA6 used: PG12 conflicts with ETH_TXD1 ***
# 32  | SPARE12                | —                  |
# 33  | SPI6_MOSI_EXTERNAL1    | PG14 / SPI6_MOSI   |
# 34  | SPARE13                | —                  |
# 35  | SPI6_SCK_EXTERNAL1     | PB3  / SPI6_SCK    |
# 36  | SPARE14                | —                  |
# 37  | GND                    | —                  |
# 38  | SPARE15                | —                  |
# 39  | SPI6_nRESET_EXTERNAL1  | PF10               | *** AVAILABLE on STM32 ***
# 40  | SPARE16                | —                  |
# 41  | SPI6_nCS1_EXTERNAL1    | PI10               | *** AVAILABLE on STM32 ***
# 42  | SPARE17                | —                  |
# 43  | SPI6_nCS2_EXTERNAL1    | PA15               | *** AVAILABLE on STM32 ***
# 44  | PG6                    | PG6                | *** AVAILABLE on STM32 ***
# 45  | SPI6_DRDY2_EXTERNAL1   | PD12               | *** AVAILABLE on STM32 ***
# 46  | GND                    | —                  |
# 47  | SPI6_DRDY1_EXTERNAL1   | PD11               | *** AVAILABLE on STM32 ***
# 48  | NFC_GPIO               | PC0                | PX4 NFC GPIO
# 49  | SPIX_SYNC              | PE9  / TIM1_CH1    | PX4 GPIO_SYNC (preferred)
# 50  | PD15 (reserved)        | PD15               | Spare GPIO per PX4
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# IO ports
# -----------------------------------------------------------------------------

# Ethernet RMII interface (uses single interface for all RMII signals)
eth_rmii = io("eth_rmii", Rmii)
eth_mdio = io("eth_mdio", Gpio)  # Management interface (separate from RMII)
eth_mdc = io("eth_mdc", Gpio)  # Management interface (separate from RMII)
eth_power_en = io("eth_power_en", Gpio)

# SPI6 interface (with built-in CS and additional signals)
spi6 = io("spi6", Spi)  # SPI6 with built-in CS (PI10)
spi6_reset = io("spi6_reset", Gpio)  # PF10 - External SPI reset
spi6_cs2 = io("spi6_cs2", Gpio)  # PA15 - Additional chip select
spi6_drdy1 = io("spi6_drdy1", Gpio)  # PD11 - Data ready 1
spi6_drdy2 = io("spi6_drdy2", Gpio)  # PD12 - Data ready 2

# Special function pins (AVAILABLE on STM32)
spix_sync = io("spix_sync", Gpio)  # PH10/TIM5_CH1 (AVAILABLE)
nfc_gpio = io("nfc_gpio", Gpio)  # PH3 (AVAILABLE)

# Reserved GPIO pins (AVAILABLE on STM32)
gpio_pg6 = io("gpio_pg6", Gpio)  # PG6 (AVAILABLE)
gpio_pd15 = io("gpio_pd15", Gpio)  # PD15 (reserved spare)

# Spare pins (not connected)
spare01 = NotConnected("SPARE01")
spare02 = NotConnected("SPARE02")
spare03 = NotConnected("SPARE03")
spare04 = NotConnected("SPARE04")
spare05 = NotConnected("SPARE05")
spare06 = NotConnected("SPARE06")
spare07 = NotConnected("SPARE07")
spare08 = NotConnected("SPARE08")
spare09 = NotConnected("SPARE09")
spare10 = NotConnected("SPARE10")
spare11 = NotConnected("SPARE11")
spare12 = NotConnected("SPARE12")
spare13 = NotConnected("SPARE13")
spare14 = NotConnected("SPARE14")
spare15 = NotConnected("SPARE15")
spare16 = NotConnected("SPARE16")
spare17 = NotConnected("SPARE17")

# Pins not available on STM32 module (use spare nets)
# These pins are now available from the STM32H753 module
# (removed NotConnected, will use actual GPIO interfaces)

# Ground
gnd = io("gnd", Ground)

# -----------------------------------------------------------------------------
# Component definition
# -----------------------------------------------------------------------------

Component(
    name="X2",
    symbol=Symbol(
        library="@kicad-symbols/Connector_Generic_MountingPin.kicad_sym", name="Conn_02x25_Odd_Even_MountingPin"
    ),
    footprint=File("@kicad-footprints/Connector_Hirose_DF40.pretty/Hirose_DF40C-50DP-0.4V_2x25-1MP_P0.4mm.kicad_mod"),
    prefix="J",
    mpn="DF40C-50DP-0.4V(51)",
    manufacturer="Hirose Electric Co Ltd",
    description="50-pin B2B connector - FMU X2 high-speed/expansion",
    properties={"pitch": "0.4mm", "stack_height": "3mm"},
    pins={
        "Pin_1": gnd,  # 1 - GND
        "Pin_2": eth_mdio,  # 2 - ETH_MDIO (PA2/ETH_MDIO)
        "Pin_3": eth_rmii.REF_CLK,  # 3 - ETH_REF_CLK (PA1/ETH_REF_CLK)
        "Pin_4": eth_mdc,  # 4 - ETH_MDC (PC1/ETH_MDC)
        "Pin_5": gnd,  # 5 - GND
        "Pin_6": eth_power_en,  # 6 - ETH_POWER_EN (PG15)
        "Pin_7": eth_rmii.CRS_DV,  # 7 - ETH_CRS_DV (PA7/ETH_CRS_DV)
        "Pin_8": gnd,  # 8 - GND
        "Pin_9": gnd,  # 9 - GND
        "Pin_10": spare01,  # 10 - SPARE01
        "Pin_11": eth_rmii.RXD0,  # 11 - ETH_RXD0 (PC4/ETH_RXD0)
        "Pin_12": spare02,  # 12 - SPARE02
        "Pin_13": gnd,  # 13 - GND
        "Pin_14": spare03,  # 14 - SPARE03
        "Pin_15": eth_rmii.RXD1,  # 15 - ETH_RXD1 (PC5/ETH_RXD1)
        "Pin_16": spare04,  # 16 - SPARE04
        "Pin_17": gnd,  # 17 - GND
        "Pin_18": spare05,  # 18 - SPARE05
        "Pin_19": eth_rmii.TXD0,  # 19 - ETH_TXD0 (PG13/ETH_TXD0)
        "Pin_20": spare06,  # 20 - SPARE06
        "Pin_21": gnd,  # 21 - GND
        "Pin_22": spare07,  # 22 - SPARE07
        "Pin_23": eth_rmii.TXD1,  # 23 - ETH_TXD1 (PG12/ETH_TXD1) *** STM32 mapping ***
        "Pin_24": spare08,  # 24 - SPARE08
        "Pin_25": gnd,  # 25 - GND
        "Pin_26": spare09,  # 26 - SPARE09
        "Pin_27": eth_rmii.TX_EN,  # 27 - ETH_TX_EN (PB11/ETH_TX_EN)
        "Pin_28": spare10,  # 28 - SPARE10
        "Pin_29": gnd,  # 29 - GND
        "Pin_30": spare11,  # 30 - SPARE11
        "Pin_31": spi6.MISO,  # 31 - SPI6_MISO_EXTERNAL1 (PA6/SPI6_MISO) *** STM32 mapping ***
        "Pin_32": spare12,  # 32 - SPARE12
        "Pin_33": spi6.MOSI,  # 33 - SPI6_MOSI_EXTERNAL1 (PG14/SPI6_MOSI)
        "Pin_34": spare13,  # 34 - SPARE13
        "Pin_35": spi6.CLK,  # 35 - SPI6_SCK_EXTERNAL1 (PB3/SPI6_SCK)
        "Pin_36": spare14,  # 36 - SPARE14
        "Pin_37": gnd,  # 37 - GND
        "Pin_38": spare15,  # 38 - SPARE15
        "Pin_39": spi6_reset,  # 39 - SPI6_nRESET_EXTERNAL1 (PF10)
        "Pin_40": spare16,  # 40 - SPARE16
        "Pin_41": spi6.CS,  # 41 - SPI6_nCS1_EXTERNAL1 (PI10) *** Uses SPI interface CS ***
        "Pin_42": spare17,  # 42 - SPARE17
        "Pin_43": spi6_cs2,  # 43 - SPI6_nCS2_EXTERNAL1 (PA15) *** AVAILABLE ***
        "Pin_44": gpio_pg6,  # 44 - PG6 (reserved GPIO)
        "Pin_45": spi6_drdy2,  # 45 - SPI6_DRDY2_EXTERNAL1 (PD12) *** AVAILABLE ***
        "Pin_46": gnd,  # 46 - GND
        "Pin_47": spi6_drdy1,  # 47 - SPI6_DRDY1_EXTERNAL1 (PD11) *** AVAILABLE ***
        "Pin_48": nfc_gpio,  # 48 - NFC_GPIO (PH3)
        "Pin_49": spix_sync,  # 49 - SPIX_SYNC (PH10/TIM5_CH1)
        "Pin_50": gpio_pd15,  # 50 - PD15 (reserved)
        "MountPin": gnd,  # MP - Mounting Pins (to ground)
    },
)
