load("@stdlib/properties.zen", "Layout")

BSS138_7_F = Module("github.com/diodeinc/registry/components/BSS138-7-F/BSS138-7-F.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")

# bidirectional level shifter for low voltage logic.

pullup_value = config(str, default="10kohm 10%", optional=True)
dnp_pullup_source = config(bool, default=False, optional=True)

SIGNAL_LOWER = io(Net)
SIGNAL_UPPER = io(Net)
POWER_UPPER = io(Power)
POWER_LOWER = io(Power)

BSS138_7_F(
    name="level_shift_fet_tx",
    G=POWER_LOWER,
    D=SIGNAL_UPPER,
    S=SIGNAL_LOWER,
)
Resistor(
    name="pullup_source",
    value=pullup_value,
    package="0402",
    P1=POWER_LOWER,
    P2=SIGNAL_LOWER,
    dnp=dnp_pullup_source,
)
Resistor(
    name="pullup_drain",
    value=pullup_value,
    package="0402",
    P1=POWER_UPPER,
    P2=SIGNAL_UPPER,
)

Layout(
    name="LevelShiftFet",
    path="layout/LevelShiftFet",
)

