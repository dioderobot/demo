load("@stdlib/interfaces.zen", "Can", "CanTtl", "Power", "Ground", "Gpio")

Capacitor = Module("@stdlib/generics/Capacitor.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")

# -----------------------------------------------------------------------------
# TJA1051TK/3 High-Speed CAN Transceiver Module
# -----------------------------------------------------------------------------
# NXP TJA1051TK/3 CAN transceiver in HVSON-8 package with separate VIO
# Provides isolated CAN communication for microcontrollers
# Features:
# - ISO 11898-2:2003 compliant
# - Up to 5 Mbit/s CAN FD support
# - Silent mode control
# - Separate VIO for level translation
# - Thermal shutdown protection
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------------------

# Termination option - adds 120 ohm split termination with capacitor
terminate = config("terminate", bool, default=False, optional=True)

# -----------------------------------------------------------------------------
# I/O interfaces
# -----------------------------------------------------------------------------

# CAN TTL interface (microcontroller side)
CAN_TTL = io("CAN_TTL", CanTtl)

# CAN bus interface (physical bus side)
CAN_BUS = io("CAN_BUS", Can)

# Power interfaces
VCC = io("VCC", Power)  # Main supply (3.3V or 5V)
VIO = io("VIO", Power)  # I/O supply for level translation
GND = io("GND", Ground)  # Ground

# Control interface
SILENT = io("SILENT", Gpio, default=Gpio("SILENT"), optional=True)  # Silent mode control (active high)


# -----------------------------------------------------------------------------
# Passive components
# -----------------------------------------------------------------------------

# Decoupling capacitors
Capacitor(name="C1", value="100nF", package="0402", voltage="16V", P1=VCC, P2=GND)
Capacitor(name="C2", value="100nF", package="0402", voltage="16V", P1=VIO, P2=GND)

# CAN bus termination (120 ohm split termination with capacitor for better EMC)
if terminate:
    Resistor(name="R_TERM1", value="60Ohm", package="0402", P1=CAN_BUS.CAN_H, P2=Net("CAN_TERM_MID"))
    Resistor(name="R_TERM2", value="60Ohm", package="0402", P1=Net("CAN_TERM_MID"), P2=CAN_BUS.CAN_L)
    Capacitor(name="C_TERM", value="4.7nF", package="0402", voltage="16V", P1=Net("CAN_TERM_MID"), P2=GND)

# Note: Silent pin (S) has internal pull-down per datasheet section 7.2.2
# External pull-down not required but can be added for extra assurance

# -----------------------------------------------------------------------------
# Component definition
# -----------------------------------------------------------------------------

Component(
    name="U",
    symbol=Symbol(library="@kicad-symbols/Interface_CAN_LIN.kicad_sym", name="TJA1051TK-3"),
    footprint=File("@kicad-footprints/Package_SON.pretty/HVSON-8-1EP_3x3mm_P0.65mm_EP1.6x2.4mm.kicad_mod"),
    prefix="U",
    mpn="TJA1051TK/3,118",
    manufacturer="NXP",
    description="High-Speed CAN Transceiver",
    pin_defs={
        "TXD": "1",  # CAN transmit data input
        "GND": "2",  # Ground
        "VCC": "3",  # Supply voltage
        "RXD": "4",  # CAN receive data output
        "VIO": "5",  # I/O supply voltage
        "CANL": "6",  # CAN bus low
        "CANH": "7",  # CAN bus high
        "S": "8",  # Silent mode control (active high)
        "EP": "9",  # Exposed pad (ground)
    },
    pins={
        "TXD": CAN_TTL.TX,
        "GND": GND,
        "VCC": VCC,
        "RXD": CAN_TTL.RX,
        "VIO": VIO,
        "CANL": CAN_BUS.CAN_L,
        "CANH": CAN_BUS.CAN_H,
        "S": SILENT,
        "EP": GND,
    },
    properties={
        "package": "HVSON-8",
        "supply_voltage": "3.0V-5.5V",
        "io_voltage": "1.65V-5.5V",
        "can_speed": "5 Mbit/s",
        "temperature_range": "-40°C to +150°C",
    },
)
