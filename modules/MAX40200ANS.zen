load("@stdlib/interfaces.zen", "Power", "Ground", "Gpio")

Capacitor = Module("@stdlib/generics/Capacitor.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")

# -----------------------------------------------------------------------------
# MAX40200ANS - Ultra-Low Voltage Drop Ideal Diode
#
# Features:
# - Ultra-low voltage drop: 43mV typ @ 500mA, 85mV typ @ 1A
# - Supply voltage range: 1.5V to 5.5V
# - Current capability: Up to 1A
# - Enable pin with weak internal pullup
# - Thermal protection at 154°C
# - Low quiescent current: 7µA typ, 18µA max
# - WLP-4 package: 0.73mm x 0.73mm
#
# Pin mapping (WLP-4):
# A1 - VDD (Supply Input/Anode)
# A2 - OUT (Ideal Diode Output/Cathode)
# B1 - EN (Active-High Enable Input)
# B2 - GND (Circuit Ground)
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# IO ports
# -----------------------------------------------------------------------------

# Power connections
vdd = io("VDD", Power)  # Supply input (anode)
out = io("OUT", Power)  # Ideal diode output (cathode)
gnd = io("GND", Ground)  # Circuit ground

# Control
en = io("EN", Gpio)  # Active-high enable input (with weak internal pullup)

# -----------------------------------------------------------------------------
# Component definition
# -----------------------------------------------------------------------------

Component(
    name="U",
    symbol=Symbol(library="@kicad-symbols/Analog_Switch.kicad_sym", name="MAX40200ANS"),
    footprint=File("@kicad-footprints/Package_BGA.pretty/WLP-4_0.728x0.728mm_Layout2x2_P0.35mm.kicad_mod"),
    prefix="U",
    mpn="MAX40200ANS+",
    manufacturer="Analog Devices (Maxim)",
    description="Ultra-Low Voltage Drop Ideal Diode",
    datasheet="https://datasheets.maximintegrated.com/en/ds/MAX40200.pdf",
    properties={
        "voltage_drop_typ": "43mV @ 500mA, 85mV @ 1A",
        "quiescent_current": "7µA typ, 18µA max",
        "thermal_protection": "154°C",
        "package": "WLP-4",
    },
    pins={
        "VDD": vdd,  # A1 - Supply Input (Anode)
        "OUT": out,  # A2 - Ideal Diode Output (Cathode)
        "EN": en,  # B1 - Active-High Enable Input
        "GND": gnd,  # B2 - Circuit Ground
    },
)

# -----------------------------------------------------------------------------
# Passive components (per datasheet recommendations)
# -----------------------------------------------------------------------------

# Input decoupling capacitor (VDD to GND)
# Datasheet: "minimum of 0.33μF on the VDD input" for stability
Capacitor(name="C_IN", value="4.7uF", package="0402", voltage="10V", dielectric="X7R", P1=vdd, P2=gnd)

# Output decoupling capacitor (OUT to GND)
# Datasheet: "minimum of 0.33μF connected to the OUT output" for stability
Capacitor(name="C_OUT", value="10uF", package="0402", voltage="10V", dielectric="X7R", P1=out, P2=gnd)

# Enable pullup resistor (VDD to EN)
# Optional: provides noise immunity (IC has weak internal pullup)
Resistor(name="R_EN", value="10kOhm", package="0402", P1=vdd, P2=en)
