"""
TPD4E05U06 4-Channel ESD Protection Array Module
Automotive-grade USB 2.0 ESD protection diode
"""

load("@stdlib/interfaces.zen", "Ground", "Power", "Usb2")

GND = io("GND", Ground)
D1P = io("D1P", Net)
D1M = io("D1M", Net)
D2P = io("D2P", Net)
D2M = io("D2M", Net)

Component(
    name="TVS",
    symbol=Symbol(library="@kicad-symbols/Power_Protection.kicad_sym", name="TPD4E05U06DQA"),
    footprint=File("@kicad-footprints/Package_SON.pretty/USON-10_2.5x1.0mm_P0.5mm.kicad_mod"),
    prefix="D",
    pin_defs={
        "D1+": "1",
        "D1-": "2",
        "GND.1": "3",
        "D2+": "4",
        "D2-": "5",
        "NC.1": "6",
        "NC.2": "7",
        "GND.2": "8",
        "NC.3": "9",
        "NC.4": "10",
    },
    pins={
        "GND.1": GND,
        "GND.2": GND,
        "D1+": D1P,
        "D1-": D1M,
        "D2+": D2P,
        "D2-": D2M,
        "NC.4": D1P,
        "NC.3": D1M,
        "NC.2": D2P,
        "NC.1": D2M,
    },
    mpn="TPD4E05U06QDQARQ1",
    manufacturer="Texas Instruments",
    description="4-Channel ESD Protection Array, USB 2.0, Automotive",
    properties={
        "esd_rating": "±30kV",
        "io_capacitance": "0.5pF",
        "clamping_voltage": "5.5V",
        "alternatives": [
            {"mpn": "TPD4E05U06DQAR", "manufacturer": "Texas Instruments"},
        ],
    },
)
