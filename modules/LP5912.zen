load("@stdlib/interfaces.zen", "Power", "Ground", "Gpio", "NotConnected")

Capacitor = Module("@stdlib/generics/Capacitor.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")

# -----------------------------------------------------------------------------
# LP5912-3.3 Low-Noise LDO Regulator Module
# -----------------------------------------------------------------------------
# Texas Instruments LP5912-3.3DRV low-noise LDO in WSON-6 package
# Features:
# - Input: 1.6V to 6.5V
# - Output: 3.3V fixed ±2% accuracy
# - Current: up to 500mA
# - Low noise: 12μVRMS typical
# - PSRR: 75dB at 1kHz
# - Low dropout: 95mV at 500mA
# - Power-good output with 140μs delay
# - Internal soft-start and thermal protection
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# I/O interfaces
# -----------------------------------------------------------------------------

# Power interfaces
vin = io("vin", Power)  # Input voltage (1.6V to 6.5V)
vout = io("vout", Power)  # Regulated 3.3V output
gnd = io("gnd", Ground)  # Ground

# Control interfaces
en = io("en", Gpio, default=Gpio("en"), optional=True)  # Enable input (active high, internal pulldown)
pg = io("pg", Gpio, default=Gpio("pg"), optional=True)  # Power-good output (open-drain, requires pullup)

# Configuration
pg_pullup = config("pg_pullup", bool, default=False, optional=True)  # Enable PG pullup resistor
en_pullup = config("en_pullup", bool, default=False, optional=True)  # Enable EN pullup resistor

# -----------------------------------------------------------------------------
# Passive components
# -----------------------------------------------------------------------------

# Input/output capacitors per datasheet recommendation (1μF each)
Capacitor(name="C_IN", value="1uF", package="0402", voltage="10V", dielectric="X7R", P1=vin, P2=gnd)
Capacitor(name="C_OUT", value="4.7uF", package="0402", voltage="6.3V", dielectric="X7R", P1=vout, P2=gnd)

# Enable pullup resistor (optional, 10kΩ to VIN for default-on operation)
if en_pullup:
    Resistor(name="R_EN", value="10kOhm", package="0402", P1=vin, P2=en)

# Power-good pullup resistor (optional, 10kΩ to VIN per typical application)
if pg_pullup:
    Resistor(name="R_PG", value="10kOhm", package="0402", P1=vin, P2=pg)


# -----------------------------------------------------------------------------
# Component definition
# -----------------------------------------------------------------------------

Component(
    name="U",
    symbol=Symbol(library="@kicad-symbols/Regulator_Linear.kicad_sym", name="LP5912-3.3DRV"),
    footprint=File("@kicad-footprints/Package_SON.pretty/WSON-6-1EP_2x2mm_P0.65mm_EP1x1.6mm.kicad_mod"),
    prefix="U",
    mpn="LP5912-3.3DRVR",
    manufacturer="Texas Instruments",
    description="500-mA Low-Noise Low-IQ LDO",
    pin_defs={
        "OUT": "1",  # Regulated output voltage
        "NC": "2",  # No connection
        "PG": "3",  # Power-good indicator (open-drain)
        "EN": "4",  # Enable input (active high)
        "GND": "5",  # Ground
        "IN": "6",  # Unregulated input voltage
        "EP": "7",  # Exposed thermal pad
    },
    pins={
        "OUT": vout.NET,
        "NC": NotConnected("NC"),
        "PG": pg.NET,
        "EN": en.NET,
        "GND": gnd.NET,
        "IN": vin.NET,
        "EP": gnd.NET,  # Thermal pad connected to ground per datasheet
    },
    properties={
        "package": "WSON-6",
        "input_voltage": "1.6V-6.5V",
        "output_voltage": "3.3V ±2%",
        "output_current": "500mA",
        "noise": "12μVRMS",
        "psrr": "75dB@1kHz",
        "dropout": "95mV@500mA",
        "temperature_range": "-40°C to +125°C",
    },
)
