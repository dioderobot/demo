load("@stdlib/interfaces.zen", "I2c", "Power", "Ground", "Gpio")

Capacitor = Module("@stdlib/generics/Capacitor.zen")

# BMP388 Digital Pressure Sensor
# 10-pin metal-lid LGA (2.0 x 2.0 x 0.75 mm³)
# Voltage - Supply: 1.65V to 3.6V (VDD), 1.2V to 3.6V (VDDIO)
# Interface: I2C (up to 3.4 MHz), SPI (3 and 4 wire, up to 10 MHz)
# Temperature: -40°C ~ 85°C
# Pressure: 300-1250 hPa (Absolute)
# Relative accuracy: ±8 Pa (±0.66 m)

# I2C address configuration (SDO pin sets LSB)
# SDO=GND: 0x76, SDO=VDDIO: 0x77
address = config("address", int, default=0x77)

# Validate address
if address not in [0x76, 0x77]:
    error("Invalid I2C address: " + str(address) + ". BMP388 addresses must be 0x76 or 0x77")

# Extract SDO pin state from address
sdo_high = address == 0x77



# I/O ports
VCC = io("VCC", Power)           # Power supply (1.71V to 3.6V for both VDD and VDDIO)
GND = io("GND", Ground)          # Ground
I2C = io("I2C", I2c)             # I2C interface

# Interrupt pin
INT = io("INT", Gpio)            # Interrupt output pin

# Main component
Component(
    name="U",
    footprint=File("@kicad-footprints/Package_LGA.pretty/ST_HLGA-10_2x2mm_P0.5mm_LayoutBorder3x2y.kicad_mod"),
    pin_defs = {
        "VDDIO": "1",    # Digital interface supply
        "SCK": "2",      # Serial clock input (SCL for I2C)
        "VSS1": "3",     # Ground
        "SDI": "4",      # Serial data input (SDA for I2C)
        "SDO": "5",      # Serial data output / I2C Address Select (SA0)
        "CSB": "6",      # Chip select (tie high for I2C)
        "INT": "7",      # Interrupt output
        "VSS2": "8",     # Ground
        "VSS3": "9",     # Ground
        "VDD": "10"      # Analog supply voltage
    },
    pins={
        "VDDIO": VCC.NET,           # Digital interface supply
        "SCK": I2C.SCL,             # Serial clock (I2C SCL)
        "VSS1": GND.NET,            # Ground
        "SDI": I2C.SDA,             # Serial data input (I2C SDA)
        "SDO": VCC.NET if sdo_high else GND.NET,  # I2C address select (SA0)
        "CSB": VCC.NET,             # Chip select (tie high for I2C)
        "INT": INT.NET,             # Interrupt output
        "VSS2": GND.NET,            # Ground
        "VSS3": GND.NET,            # Ground
        "VDD": VCC.NET              # Analog supply voltage
    },
    properties={
        "package": "10-LGA (2.0x2.0x0.75mm)",
    },
    mpn="BMP388"
)

# Power supply decoupling capacitors
# VCC supply (both analog VDD and digital VDDIO, 3.3V typ)
# Separate caps for each power pin for better high-frequency decoupling
Capacitor(name="C1", value="100nF", package="0402", voltage="6.3V", dielectric="X7R", P1=VCC, P2=GND)
Capacitor(name="C2", value="100nF", package="0402", voltage="6.3V", dielectric="X7R", P1=VCC, P2=GND)
